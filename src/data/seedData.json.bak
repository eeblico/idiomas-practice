      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7797_1775653143235.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007798",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "You spend holidays together.",
      "translation": "Vocês passam as férias juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7798_1775653143422.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007799",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "You prefer to stay close to them.",
      "translation": "Você prefere ficar perto deles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7799_1775653143634.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007800",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "You miss them when you travel.",
      "translation": "Você sente falta deles quando viaja.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7800_1775653143830.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007801",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He lives near his parents.",
      "translation": "Ele mora perto dos pais dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7801_1775653143998.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007802",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He works with his brother.",
      "translation": "Ele trabalha com o irmão dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7802_1775653144261.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007803",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He looks after his mother.",
      "translation": "Ele cuida da mãe dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7803_1775653144429.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007804",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He respects his father a lot.",
      "translation": "Ele respeita muito o pai dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7804_1775653144638.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007805",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He argues with his sister often.",
      "translation": "Ele discute com a irmã dele com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7805_1775653144854.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007806",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He calls his family every day.",
      "translation": "Ele liga para a família todos os dias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7806_1775653186505.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007807",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He supports his parents financially.",
      "translation": "Ele sustenta os pais financeiramente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7807_1775653186732.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007808",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He spends weekends with them.",
      "translation": "Ele passa os fins de semana com eles.",
