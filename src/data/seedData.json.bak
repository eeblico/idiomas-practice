      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12474_1778485556335.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012475",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "No me echo la siesta.",
      "translation": "Eu não tiro cochilos.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 1",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12475_1778485556526.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012476",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿Qué haces después del trabajo?",
