      "id": "p1f13e77-9dfc-4b55-a0bc-000000009252",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Mi tarjeta de acceso no funciona en la puerta.",
