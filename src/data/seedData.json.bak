      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009338",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Cuál es la forma más rápida de llegar al puerto?",
      "translation": "Qual é o caminho mais rápido para chegar ao porto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9338_1778571875999.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009339",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Gracias, ha sido de gran ayuda hoy.",
      "translation": "Obrigado, você foi muito prestativo hoje.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9339_1778571876317.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000013892",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000243",
      "text": "Leo todos los días.",
      "translation": "Eu leio todos os dias.",
      "explanation": "Frase da coleção: Intellectual & Learning",
      "difficulty": "easy",
