      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009259",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Hay un ruido extraño que viene de la ventilación.",
      "translation": "Tem um barulho estranho vindo da ventilação.",
