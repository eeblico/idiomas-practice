      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010419",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El desayuno se sirve de siete a diez.",
      "translation": "O restaurante abre às seis.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10419_1778570413595.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010420",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El restaurante abre a las seis.",
      "translation": "O bar fecha à meia-noite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10420_1778570416074.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010421",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El bar cierra a medianoche.",
      "translation": "A equipe de limpeza vem de manhã.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10421_1778570416423.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010422",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El servicio de limpieza pasa por la mañana.",
      "translation": "O elevador fica à esquerda.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10422_1778570416698.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010423",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El ascensor está a la izquierda.",
      "translation": "O banheiro fica no andar de baixo.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10423_1778570416988.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010424",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Los baños están en la planta de abajo.",
      "translation": "A recepção fica aberta o dia todo.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10424_1778570417301.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010425",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "La recepción está abierta todo el día.",
      "translation": "A saída fica no final do corredor.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10425_1778570417620.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010426",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "La salida está al final del pasillo.",
      "translation": "Nós podemos providenciar um táxi.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10426_1778570417953.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010427",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Podemos pedirle un taxi.",
      "translation": "Podemos guardar sua bagagem.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10427_1778570418290.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010428",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Podemos guardar su equipaje.",
      "translation": "Podemos recomendar lugares locais.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10428_1778570418556.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010429",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Podemos recomendarle lugares locales.",
      "translation": "Podemos reservar um passeio para você.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10429_1778570418847.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010430",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Podemos reservarle una excursión.",
      "translation": "Vou consertar isso imediatamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10430_1778570419185.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010431",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Solucionaré esto inmediatamente.",
      "translation": "Vou falar com o gerente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10431_1778570419480.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010432",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Hablaré con el gerente.",
      "translation": "Vou verificar o problema.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10432_1778570426758.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010433",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Revisaré el problema.",
      "translation": "Vou encontrar uma solução.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10433_1778570427074.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010434",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Encontraré una solución.",
      "translation": "Sinto muito pelo inconveniente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10434_1778570427373.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010435",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Lamento las molestias.",
      "translation": "Peço desculpas pelo atraso.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10435_1778570427675.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010436",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Le pido disculpas por el retraso.",
      "translation": "Obrigado por nos avisar.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10436_1778570428009.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010437",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Gracias por hacérnoslo saber.",
      "translation": "Agradecemos o seu feedback.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10437_1778570428378.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010438",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Agradecemos sus comentarios.",
      "translation": "Nós cuidaremos disso.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10438_1778570428703.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010439",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Nos encargaremos de esto.",
      "translation": "Nós resolveremos isso rapidamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10439_1778570428980.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010440",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Lo resolveremos rápidamente.",
      "translation": "Garantiremos que isso não aconteça novamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10440_1778570270253.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010441",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Nos aseguraremos de que no vuelva a ocurrir.",
      "translation": "Sua satisfação é importante para nós.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10441_1778570273286.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010442",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su satisfacción es importante para nosotros.",
      "translation": "Queremos que você tenha uma boa experiência.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10442_1778570273591.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010443",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Queremos que tenga una buena experiencia.",
      "translation": "Por favor, nos avise se precisar de algo.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10443_1778570273948.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010444",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Va a registrar su entrada?",
      "translation": "Você está fazendo o check-in?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10444_1778570274267.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010445",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Va a registrar su salida?",
      "translation": "Você está fazendo o check-out?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10445_1778570274640.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010446",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Disfrutó de su estancia?",
      "translation": "Você gostou da sua estadia?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10446_1778570274929.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010447",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Le gustaría volver a reservar?",
      "translation": "Gostaria de reservar novamente?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10447_1778570275341.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010448",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El total aparece en la pantalla.",
      "translation": "O total está na tela.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10448_1778570275622.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010449",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Puede pagar con tarjeta.",
      "translation": "Você pode pagar com cartão.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10449_1778570275984.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010450",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Puede pagar en efectivo.",
      "translation": "Você pode pagar em dinheiro.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10450_1778570276240.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010451",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Aquí tiene su cambio.",
      "translation": "Aqui está seu troco.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10451_1778570276524.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010452",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Tenga un buen viaje.",
      "translation": "Tenha uma boa viagem.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10452_1778570276799.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010453",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Que aproveche.",
      "translation": "Bom apetite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10453_1778570277065.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010454",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Disfrute de su estancia.",
      "translation": "Aproveite sua estadia.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10454_1778570277335.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010455",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Esperamos volver a verle.",
      "translation": "Esperamos vê-lo novamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10455_1778570277598.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010456",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Bienvenido a nuestro hotel, estamos encantados de tenerle con nosotros esta noche.",
      "translation": "Bem-vindo ao nosso hotel, estamos encantados em tê-lo conosco esta noite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10456_1778570277889.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010457",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Bienvenido a nuestro restaurante, es un honor recibirle esta noche.",
      "translation": "Bem-vindo ao nosso restaurante, estamos honrados em recebê-lo esta noite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10457_1778570278255.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010458",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su suite está totalmente preparada y lista para su llegada.",
      "translation": "Sua suíte está totalmente preparada e pronta para sua chegada.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10458_1778570278558.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010459",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su mesa en la terraza está lista, con una hermosa vista de la ciudad.",
      "translation": "Sua mesa no terraço está pronta, com uma bela vista da cidade.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10459_1778570278911.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010460",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Permítame ayudarle con su equipaje y acompañarle a su suite.",
      "translation": "Permita-me ajudá-lo com sua bagagem e acompanhá-lo até sua suíte.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10460_1778570279215.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010461",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Por favor, sígame, le acompañaré personalmente a su mesa.",
      "translation": "Por favor, siga-me, eu pessoalmente o mostrarei sua mesa.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10461_1778570279630.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010462",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo confirmar su reserva para dos personas por tres noches?",
      "translation": "Posso confirmar sua reserva para dois hóspedes por três noites?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10462_1778570279928.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010463",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo confirmar su reserva de cena para cuatro personas a las ocho?",
      "translation": "Posso confirmar sua reserva de jantar para quatro pessoas às oito horas?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10463_1778570280294.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010464",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Cómo puedo ayudarle durante su estancia con nosotros?",
      "translation": "Como posso ajudá-lo durante sua estadia conosco?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10464_1778570280562.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010465",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Cómo podemos hacer que su velada sea más agradable?",
      "translation": "Como podemos tornar sua noite mais agradável?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10465_1778570280841.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010466",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Aquí tiene su tarjeta llave, que le da acceso al spa y al salón privado.",
      "translation": "Aqui está seu cartão-chave, que lhe dá acesso ao spa e ao lounge privado.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10466_1778570281265.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010467",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Aquí tiene la carta, que incluye nuestra selección de degustación de temporada.",
      "translation": "Aqui está o seu cardápio, que apresenta a nossa seleção de degustação sazonal.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10467_1778570281713.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010468",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Aquí tiene los detalles de su reserva, incluyendo el desayuno y el acceso al spa.",
      "translation": "Aqui estão os detalhes da sua reserva, incluindo café da manhã e acesso ao spa.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10468_1778570282084.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010469",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Permítame comprobar eso por usted y confirmar la disponibilidad de inmediato.",
      "translation": "Permita-me verificar isso para você e confirmar a disponibilidade imediatamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10469_1778570282429.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010470",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Organizaré personalmente una salida tarde para mañana a las dos.",
      "translation": "Eu pessoalmente organizarei um check-out tardio para amanhã às duas horas.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10470_1778570428838.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010471",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Organizaré transporte privado al aeropuerto para usted.",
      "translation": "Vou organizar o transporte privado para o aeroporto para você.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10471_1778570429115.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010472",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Me pondré en contacto con nuestro conserje para organizar una visita privada por la ciudad.",
      "translation": "Vou entrar em contato com nosso concierge para agendar um passeio privado pela cidade.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10472_1778570429417.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010473",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Preferiría una mesa en el interior en una zona más tranquila o fuera en la terraza?",
      "translation": "Você prefere uma mesa interna em uma área mais tranquila ou lá fora no terraço?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10473_1778570429684.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010474",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Le apetecería una copa de champán mientras revisa la carta?",
      "translation": "Gostaria de uma taça de champanhe enquanto analisa o cardápio?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10474_1778570429986.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010475",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo recomendarle nuestro menú degustación del chef, que incluye cinco platos de autor?",
      "translation": "Posso recomendar o nosso menu degustação do chef, que inclui cinco pratos exclusivos?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10475_1778570430322.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010476",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo sugerirle un maridaje de vinos para complementar su selección?",
      "translation": "Posso sugerir uma harmonização de vinhos para complementar sua seleção?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10476_1778570430671.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010477",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Están listos para pedir, o prefieren unos momentos más para decidir?",
      "translation": "Você está pronto para pedir ou prefere mais alguns momentos para decidir?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10477_1778570430954.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010478",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo tomar nota de su pedido ahora y responder cualquier pregunta sobre los platos?",
      "translation": "Posso anotar seu pedido agora e tirar qualquer dúvida sobre os pratos?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10478_1778570431253.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010479",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Cómo le gustaría que se preparara el filete, poco hecho o al punto?",
      "translation": "Como você gostaria do seu bife, malpassado ou ao ponto?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10479_1778570431550.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010480",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo traerle otra copa de vino mientras disfruta de su plato principal?",
      "translation": "Posso lhe trazer outra taça de vinho enquanto aprecia seu prato principal?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10480_1778570431938.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010481",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo rellenar su agua o prefiere agua con gas en su lugar?",
      "translation": "Posso repor sua água ou oferecer água com gás no lugar?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10481_1778570432269.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010482",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Puedo retirar los platos para que pueda disfrutar del postre cómodamente?",
      "translation": "Posso limpar a mesa para que você possa desfrutar da sua sobremesa confortavelmente?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10482_1778570432554.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010483",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Está todo a su gusto con su comida esta noche?",
      "translation": "Está tudo a seu contento com sua refeição esta noite?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10483_1778570432998.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010484",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Es agradable la temperatura en su suite?",
      "translation": "A temperatura em sua suíte está confortável para você?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10484_1778570433314.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010485",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Hay algo que podamos preparar para que su estancia sea más agradable?",
      "translation": "Há algo que possamos preparar para tornar sua estadia mais agradável?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10485_1778570433613.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010486",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su postre se servirá en breve, ya que está recién preparado por nuestro pastelero.",
      "translation": "Sua sobremesa será servida em breve, pois é preparada na hora pelo nosso confeiteiro.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10486_1778570433860.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010487",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su coche le estará esperando en la entrada en cinco minutos.",
      "translation": "Seu carro estará esperando na entrada em cinco minutos.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10487_1778570434153.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010488",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su cita en el spa está confirmada para mañana a las diez de la mañana.",
      "translation": "Seu horário no spa está confirmado para amanhã às dez horas da manhã.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10488_1778570434559.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010489",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El desayuno se sirve en nuestro comedor principal de siete a diez cada mañana.",
      "translation": "O café da manhã é servido em nossa sala de jantar principal das sete às dez todas as manhãs.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10489_1778570434879.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010490",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El spa está abierto hasta las nueve de esta noche para su comodidad.",
      "translation": "O spa está aberto até às nove horas esta noite para sua conveniência.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10490_1778570435194.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010491",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Nuestro conserje está disponible en cualquier momento para ayudarle con peticiones especiales.",
      "translation": "Nosso concierge está disponível a qualquer momento para ajudá-lo com pedidos especiais.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10491_1778570426752.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010492",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Estaríamos encantados de organizar una excursión privada en barco por la costa para mañana por la tarde.",
      "translation": "Teremos o prazer de organizar um passeio de barco privado pela costa para amanhã à tarde.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10492_1778570427119.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010493",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Podemos reservar una mesa en uno de los mejores restaurantes de la ciudad en su nombre.",
      "translation": "Podemos reservar uma mesa em um dos melhores restaurantes da cidade em seu nome.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10493_1778570435568.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010494",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Podemos organizar una experiencia de compras personalizada con un estilista local.",
      "translation": "Podemos organizar uma experiência de compras pessoal com um estilista local.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10494_1778570435831.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010495",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Lamento sinceramente el retraso, y estamos preparando su suite con prioridad.",
      "translation": "Peço sinceras desculpas pelo atraso e estamos preparando sua suíte com prioridade.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10495_1778570427361.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010496",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Permítanos corregir esto de inmediato y ofrecerle una bebida de cortesía mientras espera.",
      "translation": "Por favor, permita-nos corrigir isso imediatamente e oferecer-lhe uma bebida cortesia enquanto espera.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10496_1778570427646.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010497",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Gracias por informarnos sobre este asunto, valoramos mucho sus comentarios.",
      "translation": "Obrigado por nos chamar a atenção para este assunto, nós realmente valorizamos o seu feedback.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10497_1778570427928.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010498",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Nos aseguraremos de que todo se gestione de forma discreta y eficiente.",
      "translation": "Garantiremos que tudo seja tratado com discrição e eficiência.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10498_1778570428203.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010499",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Haremos un seguimiento con usted más tarde esta noche para confirmar que todo cumple con sus expectativas.",
      "translation": "Entraremos em contato com você ainda hoje para confirmar que tudo atende às suas expectativas.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10499_1778570428507.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010500",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Su comodidad y privacidad son nuestras máximas prioridades durante su estancia.",
      "translation": "Seu conforto e privacidade são nossas maiores prioridades durante sua estadia.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10500_1778570316776.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010501",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Estamos comprometidos a proporcionarle una experiencia excepcional.",
      "translation": "Estamos comprometidos em proporcionar a você uma experiência excepcional.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10501_1778570317160.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010502",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Va a registrar su entrada por tres noches a partir de hoy?",
      "translation": "Você está fazendo o check-in para três noites a partir de hoje?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10502_1778570317482.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010503",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Va a registrar su salida esta mañana? ¿Podemos ayudarle con su equipaje?",
      "translation": "Você está fazendo o check-out esta manhã e podemos ajudá-lo com sua bagagem?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10503_1778570315608.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010504",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Disfrutó de su estancia con nosotros durante su visita?",
      "translation": "Você gostou de sua estadia conosco durante sua visita?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10504_1778570317772.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010505",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "¿Le gustaría que organizáramos su próxima estancia con antelación?",
      "translation": "Gostaria que organizássemos sua próxima estadia com antecedência?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10505_1778570318029.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010506",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "El importe total de su estancia aparece aquí para su revisión, incluyendo todos los servicios solicitados.",
      "translation": "O valor total de sua estadia está exibido aqui para sua revisão, incluindo todos os serviços solicitados.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10506_1778570318286.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010507",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Puede completar el pago con tarjeta y yo mismo lo procesaré de inmediato.",
      "translation": "Você pode concluir o pagamento com cartão e eu o processarei imediatamente para você.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10507_1778570318548.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010508",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Aquí tiene su recibo, y le agradecemos sinceramente que se haya alojado con nosotros.",
      "translation": "Aqui está o seu recibo e agradecemos sinceramente por se hospedar conosco.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10508_1778570316007.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010509",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Le deseamos una agradable velada y esperamos que disfrute del resto de su estancia.",
      "translation": "Desejamos-lhe uma noite agradável e esperamos que aproveite o resto da sua estadia.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10509_1778570316356.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010510",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Esperamos volver a darle la bienvenida para otra experiencia excepcional.",
      "translation": "Estamos ansiosos para recebê-lo de volta para outra experiência excepcional.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/254_10510_1778570318802.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009219",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Hola, tengo una reserva a nombre de John Smith.",
      "translation": "Olá, eu tenho uma reserva no nome de John Smith.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9219_1778572203541.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009220",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Me gustaría hacer el registro de entrada, por favor.",
      "translation": "Eu gostaria de fazer o check-in, por favor.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9220_1778572205798.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009221",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Aquí tiene mi pasaporte y mi tarjeta de crédito para el depósito.",
      "translation": "Aqui estão o meu passaporte e o meu cartão de crédito para o depósito.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9221_1778572203882.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009222",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Ya está lista la habitación?",
      "translation": "O quarto já está pronto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9222_1778572204167.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009223",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿A qué hora es la salida mañana?",
      "translation": "A que horas é o check-out amanhã?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9223_1778572204495.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009224",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Tiene la habitación vistas a la ciudad?",
      "translation": "O quarto tem vista para a cidade?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9224_1778572204897.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009225",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Hay una caja fuerte en la habitación para mis objetos de valor?",
      "translation": "Tem um cofre no quarto para os meus pertences de valor?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9225_1778572206069.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009226",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Puedo tener dos tarjetas llave para la habitación?",
      "translation": "Pode me dar dois cartões-chave para o quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9226_1778572205220.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009227",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿En qué planta está mi habitación?",
      "translation": "Em qual andar fica o meu quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9227_1778572205530.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009228",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Dónde están los ascensores?",
      "translation": "Onde ficam localizados os elevadores?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9228_1778572206360.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009229",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Hay alguien que pueda ayudarme con mis maletas?",
      "translation": "Há alguém que possa me ajudar com minhas malas?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9229_1778571876578.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009230",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Me gustaría una habitación para no fumadores, por favor.",
      "translation": "Eu gostaria de um quarto para não fumantes, por favor.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9230_1778572206620.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009231",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿El hotel tiene Wi-Fi gratuito?",
      "translation": "O hotel tem Wi-Fi gratuito?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9231_1778572206922.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009232",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Cuál es el nombre de la red Wi-Fi?",
      "translation": "Qual é o nome da rede Wi-Fi?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9232_1778572207174.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009233",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Cuál es la contraseña del internet?",
      "translation": "Qual é a senha da internet?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9233_1778571877001.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009234",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿El desayuno está incluido en el precio de la habitación?",
      "translation": "O café da manhã está incluído no preço do quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9234_1778572207456.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009235",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Dónde se encuentra la zona del desayuno?",
      "translation": "Onde fica a área do café da manhã?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9235_1778572207721.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009236",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿A qué hora cierra el buffet del desayuno?",
      "translation": "A que horas fecha o buffet de café da manhã?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9236_1778571877299.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
