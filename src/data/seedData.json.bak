      "id": "p1f13e77-9dfc-4b55-a0bc-000000015161",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000309",
      "text": "Aprendo de otros artistas.",
      "translation": "Eu aprendo com outros artistas.",
      "explanation": "Frase da coleção: Creative & Artistic",
