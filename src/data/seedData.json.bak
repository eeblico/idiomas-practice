      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Thank you for your hospitality.",
      "translation": "Obrigado por sua hospitalidade.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9319_1775752390746.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
