      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000243",
      "text": "Leo para relajarme.",
      "translation": "Eu leio para relaxar.",
      "explanation": "Frase da coleção: Intellectual & Learning",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/243_13895_1778499881901.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000013896",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000243",
      "text": "Leo para aprender nuevas ideas.",
      "translation": "Eu leio para aprender novas ideias.",
      "explanation": "Frase da coleção: Intellectual & Learning",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/243_13896_1778499882208.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
