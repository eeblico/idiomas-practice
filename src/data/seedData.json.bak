      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9329_1778572044424.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009330",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Puedo obtener una llave física en lugar de una tarjeta?",
      "translation": "Posso conseguir uma chave física em vez de um cartão?",
