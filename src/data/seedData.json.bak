      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My parents are married.",
      "translation": "Meus pais são casados.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7715_1775650657792.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
