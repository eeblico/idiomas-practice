      "id": "p1f13e77-9dfc-4b55-a0bc-000000009336",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Hay algún lugar donde pueda pesar mi maleta?",
      "translation": "Tem algum lugar onde eu possa pesar minha mala?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9336_1778571875217.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
