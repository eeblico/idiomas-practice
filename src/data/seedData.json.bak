      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7745_1775650801919.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007746",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We celebrate holidays together.",
      "translation": "Nós comemoramos os feriados juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7746_1775650837262.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007747",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We travel together sometimes.",
      "translation": "Nós viajamos juntos às vezes.",
