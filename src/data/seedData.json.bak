      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Haces comidas rápidas.",
      "translation": "Você faz refeições rápidas.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
