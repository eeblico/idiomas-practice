      "id": "p1f13e77-9dfc-4b55-a0bc-000000012471",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "Suelo almorzar fuera.",
      "translation": "Eu costumo almoçar fora.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 1",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12471_1778485555532.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012472",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿Qué haces por la tarde?",
