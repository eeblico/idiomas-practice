    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012452",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿Por qué lo estás aprendiendo?",
      "translation": "Por que você está aprendendo?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 1",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12452_1778485551046.mp3",
      "voice_name": "Fenrir",
