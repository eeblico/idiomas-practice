      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8729_1775730547162.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008730",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "You buy food for your family.",
      "translation": "Você compra comida para a sua família.",
