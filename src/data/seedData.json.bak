      "id": "p1f13e77-9dfc-4b55-a0bc-000000009253",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Podría despertarme a las siete de la mañana?",
      "translation": "Você poderia me acordar às sete da manhã?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9253_1778571880496.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009254",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Me gustaría pedir servicio de habitaciones, por favor.",
      "translation": "Eu gostaria de pedir serviço de quarto, por favor.",
