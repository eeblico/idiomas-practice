      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Por favor, envíe la versión final.",
      "translation": "Por favor, envie a versão final.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10031_1778512605224.mp3",
