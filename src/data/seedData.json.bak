      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Por favor, actualice esta sección.",
      "translation": "Por favor, atualize esta seção.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10027_1778512098795.mp3",
