      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "I have older siblings.",
      "translation": "Eu tenho irmãos mais velhos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7710_1775650656669.mp3",
