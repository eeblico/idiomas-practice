      "explanation": "Frase da coleção: Bars & Restaurants",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/265_15360_1778573473043.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
