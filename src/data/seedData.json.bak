    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009311",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Hay un lugar seguro para guardar mi bicicleta?",
      "translation": "Tem um lugar seguro para guardar minha bicicleta?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9311_1778572039016.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009312",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Puedo obtener una llave extra para mi compañero de habitación?",
      "translation": "Posso conseguir uma chave extra para meu colega de quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9312_1778572039338.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009313",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Necesito cancelar mi reserva para mañana por la noche.",
      "translation": "Preciso cancelar minha reserva para amanhã à noite.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9313_1778572039624.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009314",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Es posible mejorar mi habitación?",
      "translation": "É possível fazer um upgrade do meu quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9314_1778572039872.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009315",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Cuánto cuesta el ascenso a una suite?",
      "translation": "Quanto custa o upgrade para uma suíte?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9315_1778572040198.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009316",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "La habitación está un poco fría para mí.",
      "translation": "O quarto está um pouco frio demais para mim.",
