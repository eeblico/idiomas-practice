      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012477",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "Voy a casa y me relajo.",
      "translation": "Eu vou para casa e relaxo.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 1",
      "difficulty": "easy",
