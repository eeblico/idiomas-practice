      "id": "p1f13e77-9dfc-4b55-a0bc-000000007731",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi familia es muy unida.",
      "translation": "Minha família é muito próxima.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7731_1778495987514.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007732",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Hablamos todos los días.",
      "translation": "Nós conversamos todos os dias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7732_1778495922993.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007733",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Hablamos a menudo.",
      "translation": "Nós conversamos com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7733_1778495923211.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007734",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos vemos cada semana.",
      "translation": "Nós nos vemos toda semana.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7734_1778495987699.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007735",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos vemos en las vacaciones.",
      "translation": "Nós nos vemos nos feriados.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7735_1778495987958.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007736",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "No nos vemos muy a menudo.",
      "translation": "Nós não nos vemos com muita frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7736_1778495988127.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007737",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos apoyamos mutuamente.",
      "translation": "Nós nos apoiamos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7737_1778495988288.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007738",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos ayudamos mucho.",
      "translation": "Nós nos ajudamos muito.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7738_1778495988464.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007739",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "A veces discutimos.",
      "translation": "Nós discutimos às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7739_1778495988632.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007740",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Toda familia tiene problemas.",
      "translation": "Toda família tem problemas.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7740_1778495988800.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007741",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "La familia es muy importante para mí.",
      "translation": "A família é muito importante para mim.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7741_1778495988950.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007742",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Paso mucho tiempo con mi familia.",
      "translation": "Eu passo muito tempo com a minha família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7742_1778495989190.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007743",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ojalá pudiera pasar más tiempo con ellos.",
      "translation": "Eu gostaria de poder passar mais tempo com eles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7743_1778495989372.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007744",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Normalmente comemos juntos.",
      "translation": "Nós costumamos comer juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7744_1778495989525.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007745",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Celebramos los cumpleaños juntos.",
      "translation": "Nós comemoramos aniversários juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7745_1778495989684.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007746",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Celebramos las fiestas juntos.",
      "translation": "Nós comemoramos os feriados juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7746_1778495989833.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007747",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "A veces viajamos juntos.",
      "translation": "Nós viajamos juntos às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7747_1778495990004.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007748",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres son estrictos.",
      "translation": "Meus pais são rigorosos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7748_1778495990156.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007749",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres son muy relajados.",
      "translation": "Meus pais são muito tranquilos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7749_1778495990319.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007750",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres me apoyan mucho.",
      "translation": "Meus pais me dão muito apoio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7750_1778496059135.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007751",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres me enseñaron mucho.",
      "translation": "Meus pais me ensinaram muito.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7751_1778496059366.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007752",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Aprendí muchas cosas de mi familia.",
      "translation": "Eu aprendi muitas coisas com a minha família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7752_1778495923355.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007753",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis abuelos todavía viven.",
      "translation": "Meus avós ainda estão vivos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7753_1778496059558.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007754",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis abuelos viven cerca.",
      "translation": "Meus avós moram por perto.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7754_1778496059726.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007755",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis abuelos viven lejos.",
      "translation": "Meus avós moram longe.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7755_1778496059891.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007756",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Visito a mis abuelos a menudo.",
      "translation": "Eu visito meus avós com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7756_1778496060056.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007757",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Crecí cerca de mis abuelos.",
      "translation": "Eu cresci próximo aos meus avós.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7757_1778496060214.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007758",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Soy muy cercano a mi hermano.",
      "translation": "Eu sou muito próximo do meu irmão.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7758_1778495986479.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007759",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Soy muy cercana a mi hermana.",
      "translation": "Eu sou muito próximo da minha irmã.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7759_1778495986643.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007760",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Hablamos casi todos los días.",
      "translation": "Nós nos falamos quase todos os dias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7760_1778496060411.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007761",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Lo compartimos todo.",
      "translation": "Nós compartilhamos tudo.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7761_1778496060560.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007762",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "La familia es lo primero para mí.",
      "translation": "A família vem em primeiro lugar para mim.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7762_1778496060732.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007763",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi familia formó quien soy.",
      "translation": "Minha família moldou quem eu sou.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7763_1778496060874.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007764",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Trato de mantenerme conectado con mi familia.",
      "translation": "Eu tento me manter conectado com a minha família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7764_1778496061028.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007765",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Incluso cuando no estamos de acuerdo, nos respetamos.",
      "translation": "Mesmo quando discordamos, nós nos respeitamos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7765_1778496061204.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007766",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Somos diferentes, pero nos preocupamos el uno por el otro.",
      "translation": "Nós somos diferentes, mas nos importamos um com o outro.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7766_1778496061370.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007767",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Quiero formar una familia sólida.",
      "translation": "Eu quero construir uma família forte.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7767_1778496061532.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007768",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Quiero darles a mis hijos una buena vida.",
      "translation": "Eu quero dar uma vida boa aos meus filhos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7768_1778496061710.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007769",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Quiero estar presente para mi familia.",
      "translation": "Eu quero estar presente para a minha família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7769_1778496061874.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007770",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Eso me importa más que cualquier otra cosa.",
      "translation": "Isso importa mais para mim do que qualquer outra coisa.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7770_1778496062040.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007771",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Crecí en una familia pequeña.",
      "translation": "Eu cresci em uma família pequena.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7771_1778496062188.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007772",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Crecí con una hermana.",
      "translation": "Eu cresci com uma irmã.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7772_1778496062386.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007773",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Crecí con dos hermanos.",
      "translation": "Eu cresci com dois irmãos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7773_1778496062553.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007774",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Vivo cerca de mis padres.",
      "translation": "Eu moro perto dos meus pais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7774_1778496062750.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007775",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ahora vivo lejos de mi familia.",
      "translation": "Eu moro longe da minha família agora.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7775_1778496062924.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007776",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Llamo a mis padres todas las semanas.",
      "translation": "Eu ligo para os meus pais toda semana.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7776_1778496063084.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007777",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Los visito cuando puedo.",
      "translation": "Eu os visito quando posso.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7777_1778495923555.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007778",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "A veces extraño a mi familia.",
      "translation": "Eu sinto falta da minha família às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7778_1778495923699.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007779",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Dependo mucho de mis padres.",
      "translation": "Eu dependo muito dos meus pais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7779_1778496063267.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007780",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Trato de ayudarlos a menudo.",
      "translation": "Eu tento ajudá-los com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7780_1778496063516.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007781",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Respeto profundamente a mis padres.",
      "translation": "Eu respeito profundamente os meus pais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7781_1778496063674.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007782",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Aprendí muchas cosas de ellos.",
      "translation": "Eu aprendi muitas coisas com eles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7782_1778496063827.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007783",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "A veces discuto con mi hermano.",
      "translation": "Eu discuto com meu irmão às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7783_1778496063974.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007784",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Me llevo bien con mi hermana.",
      "translation": "Eu me dou bem com a minha irmã.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7784_1778496064232.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007785",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Me preocupo por mis padres.",
      "translation": "Eu me preocupo com os meus pais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7785_1778496124050.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007786",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Cuido de mi familia.",
      "translation": "Eu cuido da minha família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7786_1778496124380.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007787",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Vives con tus padres.",
      "translation": "Você mora com seus pais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7787_1778496124573.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007788",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Te mudaste lejos de tu familia.",
      "translation": "Você se mudou para longe da sua família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7788_1778496124794.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007789",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Los visitas cada mes.",
      "translation": "Você os visita todo mês.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7789_1778496125018.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007790",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Hablas con tu madre a menudo.",
      "translation": "Você fala com sua mãe com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7790_1778496125207.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007791",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ayudas a tu padre con el trabajo.",
      "translation": "Você ajuda seu pai no trabalho.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7791_1778496125376.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007792",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Te pareces a tu hermana.",
      "translation": "Você se parece com sua irmã.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7792_1778496125547.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007793",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Suenas como tu hermano.",
      "translation": "Sua voz parece com a do seu irmão.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7793_1778496125775.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007794",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Apoyas mucho a tu familia.",
      "translation": "Você apoia muito sua família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7794_1778496125991.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007795",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Te preocupas por ellos profundamente.",
      "translation": "Você se importa profundamente com eles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7795_1778496126174.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007796",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Te mantienes en contacto en línea.",
      "translation": "Você mantém contato on-line.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7796_1778496126371.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007797",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Los invitas a visitarte.",
      "translation": "Você os convida para visitarem você.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7797_1778496126574.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007798",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Pasan las vacaciones juntos.",
      "translation": "Vocês passam as férias juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7798_1778496126830.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007799",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Prefieres estar cerca de ellos.",
      "translation": "Você prefere ficar perto deles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7799_1778496127158.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007800",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Los extrañas cuando viajas.",
      "translation": "Você sente falta deles quando viaja.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7800_1778496127358.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007801",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él vive cerca de sus padres.",
      "translation": "Ele mora perto dos pais dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7801_1778496127562.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007802",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él trabaja con su hermano.",
      "translation": "Ele trabalha com o irmão dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7802_1778496127736.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007803",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él cuida a su madre.",
      "translation": "Ele cuida da mãe dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7803_1778496127937.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007804",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él respeta mucho a su padre.",
      "translation": "Ele respeita muito o pai dele.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7804_1778496128131.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007805",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él discute con su hermana a menudo.",
      "translation": "Ele discute com a irmã dele com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7805_1778496128322.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007806",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él llama a su familia todos los días.",
      "translation": "Ele liga para a família todos os dias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7806_1778496128496.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007807",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él apoya a sus padres financieramente.",
      "translation": "Ele sustenta os pais financeiramente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7807_1778496128683.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007808",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él pasa los fines de semana con ellos.",
      "translation": "Ele passa os fins de semana com eles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7808_1778496128866.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007809",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él visita a sus abuelos a menudo.",
      "translation": "Ele visita os avós com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7809_1778496129042.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007810",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él se mantiene conectado con los parientes.",
      "translation": "Ele mantém contato com os parentes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7810_1778496129282.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007811",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él regresó a casa el año pasado.",
      "translation": "Ele voltou para casa no ano passado.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7811_1778496129485.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007812",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Él quiere formar una familia.",
      "translation": "Ele quer começar uma família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7812_1778496129658.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007813",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella vive lejos de su familia.",
      "translation": "Ela mora longe da família dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7813_1778496129841.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007814",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella habla con sus padres a diario.",
      "translation": "Ela fala com os pais diariamente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7814_1778496130011.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007815",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella ayuda a su hermana con los problemas.",
      "translation": "Ela ajuda a irmã com problemas.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7815_1778496195647.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007816",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella cuida de sus hijos.",
      "translation": "Ela cuida dos filhos dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7816_1778496196131.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007817",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella pasa tiempo con parientes.",
      "translation": "Ela passa tempo com os parentes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7817_1778496196341.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007818",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella se preocupa por sus padres.",
      "translation": "Ela se preocupa com os pais dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7818_1778496196533.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007819",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella los visita durante las vacaciones.",
      "translation": "Ela os visita durante as férias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7819_1778496196983.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007820",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella envía regalos a su familia.",
      "translation": "Ela envia presentes para a família dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7820_1778496197172.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007821",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella respeta a sus abuelos.",
      "translation": "Ela respeita os avós dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7821_1778496197353.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007822",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "A ella le encantan las reuniones familiares.",
      "translation": "Ela ama reuniões de família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7822_1778496197522.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007823",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella extraña su hogar a veces.",
      "translation": "Ela sente saudades de casa às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7823_1778496197807.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007824",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ella quiere tener hijos en el futuro.",
      "translation": "Ela quer ter filhos no futuro.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7824_1778496197971.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007825",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Crecimos en la misma casa.",
      "translation": "Nós crescemos na mesma casa.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7825_1778496198153.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007826",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Compartimos muchos recuerdos familiares.",
      "translation": "Nós compartilhamos muitas memórias de família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7826_1778496198401.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007827",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos apoyamos mutuamente siempre.",
      "translation": "Nós sempre nos apoiamos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7827_1778496198782.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007828",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos reunimos en ocasiones especiales.",
      "translation": "Nós nos encontramos em ocasiões especiais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7828_1778496198960.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007829",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Celebramos los cumpleaños juntos.",
      "translation": "Nós comemoramos aniversários juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7829_1778496199133.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007830",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Visitamos a nuestros padres regularmente.",
      "translation": "Nós visitamos nossos pais regularmente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7830_1778496199323.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007831",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Hablamos en el chat familiar.",
      "translation": "Nós conversamos no chat da família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7831_1778496199512.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007832",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos ayudamos mutuamente con los problemas.",
      "translation": "Nós nos ajudamos com problemas.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7832_1778496199868.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007833",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Viajamos juntos a veces.",
      "translation": "Nós viajamos juntos às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7833_1778496200058.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007834",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos mantenemos conectados a pesar de la distancia.",
      "translation": "Nós mantemos contato apesar da distância.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7834_1778496200248.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007835",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Discutimos mucho pero perdonamos rápido.",
      "translation": "Nós discutimos muito, mas perdoamos rápido.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7835_1778496200631.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007836",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nos preocupamos profundamente el uno por el otro.",
      "translation": "Nós nos importamos profundamente uns com os outros.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7836_1778496200883.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007837",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos viven cerca de sus padres.",
      "translation": "Eles moram perto dos pais deles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7837_1778496201069.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007838",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Se mudaron al extranjero hace años.",
      "translation": "Eles se mudaram para o exterior anos atrás.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7838_1778496201264.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007839",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Rara vez ven a sus parientes.",
      "translation": "Eles raramente veem seus parentes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7839_1778496201647.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007840",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Se mantienen en contacto en línea.",
      "translation": "Eles mantêm contato on-line.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7840_1778496201896.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007841",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Se reúnen durante las vacaciones.",
      "translation": "Eles se encontram durante as férias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7841_1778496202177.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007842",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos apoyan a sus hijos.",
      "translation": "Eles apoiam os filhos deles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7842_1778496202422.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007843",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos ayudan a sus padres a menudo.",
      "translation": "Eles ajudam os pais com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7843_1778496202886.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007844",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos pasan los fines de semana juntos.",
      "translation": "Eles passam os fins de semana juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7844_1778496203094.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007845",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos disfrutan de las cenas familiares.",
      "translation": "Eles gostam de jantares em família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7845_1778496279223.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007846",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos comparten tradiciones familiares.",
      "translation": "Eles compartilham tradições familiares.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7846_1778496279422.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007847",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos crían a sus hijos juntos.",
      "translation": "Eles criam os filhos juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7847_1778496279631.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007848",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Ellos intentan mantenerse unidos.",
      "translation": "Eles tentam se manter unidos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7848_1778496279817.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007849",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres viven cerca.",
      "translation": "Meus pais moram por perto.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7849_1778496280038.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007850",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres me apoyan mucho.",
      "translation": "Meus pais dão muito apoio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7850_1778496280381.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007851",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis padres trabajaron muy duro.",
      "translation": "Meus pais trabalharam muito duro.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7851_1778496280542.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007852",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi padre viaja por trabajo.",
      "translation": "Meu pai viaja a trabalho.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7852_1778496280725.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007853",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi madre me llama a menudo.",
      "translation": "Minha mãe me liga com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7853_1778496280940.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007854",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi hermano estudia en el extranjero.",
      "translation": "Meu irmão estuda no exterior.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7854_1778496281353.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007855",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi hermana vive en otra ciudad.",
      "translation": "Minha irmã mora em outra cidade.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7855_1778496281679.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007856",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis abuelos viven en el campo.",
      "translation": "Meus avós moram no interior.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7856_1778496281853.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007857",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mis parientes nos visitan a menudo.",
      "translation": "Meus parentes nos visitam com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7857_1778496282036.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007858",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Mi familia se reúne cada año.",
      "translation": "Minha família se reúne todo ano.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7858_1778496282229.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007859",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tus padres son muy amables.",
      "translation": "Seus pais são muito gentis.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7859_1778496282407.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007860",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tu padre trabaja mucho.",
      "translation": "Seu pai trabalha muito.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7860_1778496282738.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007861",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tu madre es muy paciente.",
      "translation": "Sua mãe é muito paciente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7861_1778496283031.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007862",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tu hermano es muy protector.",
      "translation": "Seu irmão é muito protetor.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7862_1778496283207.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007863",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tu hermana es muy independiente.",
      "translation": "Sua irmã é muito independente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7863_1778496283402.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007864",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tu familia apoya tus metas.",
      "translation": "Sua família apoia seus objetivos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7864_1778496283596.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007865",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Tus parientes viven lejos.",
      "translation": "Seus parentes moram longe.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7865_1778496283772.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007866",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus padres están jubilados ahora.",
      "translation": "Os pais dele estão aposentados agora.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7866_1778496283971.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007867",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su hermano se acaba de casar.",
      "translation": "O irmão dele acabou de se casar.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7867_1778496284403.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007868",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su hermana todavía está estudiando.",
      "translation": "A irmã dele ainda está estudando.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7868_1778496284573.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007869",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su familia es dueña de un pequeño negocio.",
      "translation": "A família dele possui um pequeno negócio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7869_1778496284757.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007870",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus parientes lo visitan a menudo.",
      "translation": "Os parentes dele visitam com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7870_1778496284931.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007871",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus padres viven en el extranjero.",
      "translation": "Os pais dela moram no exterior.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7871_1778496285097.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007872",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su hermano trabaja en finanzas.",
      "translation": "O irmão dela trabalha com finanças.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7872_1778496285491.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007873",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su hermana estudia medicina.",
      "translation": "A irmã dela estuda medicina.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7873_1778496285680.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007874",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su familia es muy unida.",
      "translation": "A família dela é muito unida.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7874_1778496285861.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007875",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus parientes se reúnen cada verano.",
      "translation": "Os parentes dela se reúnem todo verão.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7875_1778496313454.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007876",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nuestros padres están orgullosos de nosotros.",
      "translation": "Nossos pais têm orgulho de nós.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7876_1778496313663.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007877",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nuestros abuelos cuentan grandes historias.",
      "translation": "Nossos avós contam ótimas histórias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7877_1778496313823.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007878",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nuestra familia valora la honestidad.",
      "translation": "Nossa família valoriza a honestidade.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7878_1778496314239.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007879",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nuestros parientes viven cerca.",
      "translation": "Nossos parentes moram por perto.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7879_1778496314742.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007880",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Nuestros hijos juegan juntos.",
      "translation": "Nossos filhos brincam juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7880_1778496314959.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007881",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus padres necesitan apoyo.",
      "translation": "Os pais deles precisam de apoio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7881_1778496315145.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007882",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus hijos aún son jóvenes.",
      "translation": "Os filhos deles ainda são jovens.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7882_1778496315354.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007883",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su familia viaja junta.",
      "translation": "A família deles viaja junta.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7883_1778496315759.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007884",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Sus parientes viven en otro país.",
      "translation": "Os parentes deles moram em outro país.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7884_1778495921068.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007885",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Su hogar siempre está abierto para la familia.",
      "translation": "A casa deles está sempre aberta para a família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/272_7885_1778496315983.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008709",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "Voy a hacer la compra una vez por semana.",
      "translation": "Eu faço compras de supermercado uma vez por semana.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/234_8709_1778496570187.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008710",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "Compro comida para toda la semana.",
      "translation": "Eu compro comida para a semana inteira.",
      "explanation": "Frase da coleção: Grocery Shopping",
