      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Cocinas los fines de semana.",
      "translation": "Você cozinha nos fins de semana.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8609_1778496629482.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008610",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él cocina todas las noches.",
      "translation": "Ele cozinha todas as noites.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8610_1778496629687.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008611",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él prepara comidas sencillas.",
      "translation": "Ele prepara refeições simples.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8611_1778496629921.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008612",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él hace parrilladas de carne a menudo.",
      "translation": "Ele grelha carne com frequência.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8612_1778496630102.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008613",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él hace el desayuno a diario.",
      "translation": "Ele faz café da manhã diariamente.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8613_1778496630323.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008614",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él come comida saludable.",
      "translation": "Ele come comida saudável.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8614_1778496630510.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008615",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él intenta cocinar más.",
      "translation": "Ele tenta cozinhar mais.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8615_1778496553249.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008616",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él aprende recetas nuevas.",
      "translation": "Ele aprende novas receitas.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8616_1778496630697.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008617",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él hace la compra.",
      "translation": "Ele faz compras de supermercado.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8617_1778496553466.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008618",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él come en casa casi todos los días.",
      "translation": "Ele come em casa na maioria dos dias.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8618_1778496630920.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008619",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él pide comida para llevar a veces.",
      "translation": "Ele pede comida para viagem às vezes.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8619_1778496631176.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008620",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él cocina para su familia.",
      "translation": "Ele cozinha para a sua família.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8620_1778496631448.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008621",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Él prepara la comida con antelación.",
      "translation": "Ele prepara a comida com antecedência.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8621_1778496631660.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008622",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella cocina muy bien.",
      "translation": "Ela cozinha muito bem.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8622_1778496631856.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008623",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella prepara comidas equilibradas.",
      "translation": "Ela prepara refeições equilibradas.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8623_1778496632056.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008624",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "A ella le gusta la repostería.",
      "translation": "Ela gosta de fazer bolos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8624_1778496632276.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008625",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella sigue recetas en internet.",
      "translation": "Ela segue receitas online.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8625_1778496632475.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008626",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella compra comida fresca.",
      "translation": "Ela compra comida fresca.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8626_1778496632704.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008627",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella toma comidas saludables.",
      "translation": "Ela come refeições saudáveis.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8627_1778496632910.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008628",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella evita la comida basura.",
      "translation": "Ela evite porcarias.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8628_1778496633114.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008629",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella cocina para todos.",
      "translation": "Ela cozinha para todos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8629_1778496633304.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008630",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella planifica menús semanales.",
      "translation": "Ela planeja cardápios semanais.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8630_1778496633494.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008631",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella prepara el almuerzo para el trabajo.",
      "translation": "Ela prepara o almoço para o trabalho.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8631_1778496633769.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008632",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella invita a sus amigos a cenar.",
      "translation": "Ela convida amigos para o jantar.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8632_1778496633964.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008633",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ella prueba platos nuevos a menudo.",
      "translation": "Ela experimenta pratos novos com frequência.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8633_1778496634143.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008634",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Cocinamos juntos.",
      "translation": "Nós cozinhamos juntos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8634_1778496634342.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008635",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Preparamos comidas a diario.",
      "translation": "Nós preparamos refeições diariamente.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8635_1778496692747.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008636",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Compartimos las tareas de la cocina.",
      "translation": "Nós dividimos as tarefas na cozinha.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8636_1778496692932.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008637",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Planificamos las comidas con antelación.",
      "translation": "Nós planejamos as refeições com antecedência.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8637_1778496700099.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008638",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Hacemos la compra juntos.",
      "translation": "Nós fazemos compras de supermercado juntos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8638_1778496700309.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008639",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Probamos recetas nuevas.",
      "translation": "Nós experimentamos novas receitas.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8639_1778496707857.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008640",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Comemos en casa a menudo.",
      "translation": "Nós comemos em casa com frequência.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8640_1778496715571.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008641",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Disfrutamos cocinando.",
      "translation": "Nós gostamos de cozinhar.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8641_1778496715754.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008642",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Preparamos la cena todas las noches.",
      "translation": "Nós preparamos o jantar todas as noites.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8642_1778496722232.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008643",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Cocinamos los fines de semana.",
      "translation": "Nós cozinhamos nos fins de semana.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8643_1778496722430.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008644",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Invitamos a amigos a comer.",
      "translation": "Nós convidamos amigos para comer.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
