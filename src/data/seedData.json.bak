      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/234_8827_1778496832098.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008828",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "Guardan la comida en la cocina.",
      "translation": "Eles guardam a comida na cozinha.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/234_8828_1778496832351.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008829",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "Ellos organizan la nevera.",
      "translation": "Eles organizam a geladeira.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/234_8829_1778496832568.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008845",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Entreno tres veces por semana.",
      "translation": "Eu malho três vezes por semana.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8845_1778496588671.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008846",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Voy al gimnasio con regularidad.",
      "translation": "Eu vou à academia regularmente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8846_1778496588852.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008847",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Entreno en casa.",
      "translation": "Eu treino em casa.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8847_1778496589068.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008848",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Corro por la mañana.",
      "translation": "Eu corro de manhã.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8848_1778496585100.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008849",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Levanto pesas.",
      "translation": "Eu levanto pesos.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8849_1778496589249.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008850",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Hago cardio dos veces por semana.",
      "translation": "Eu faço cardio duas vezes por semana.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8850_1778496585288.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008851",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Estiro después de entrenar.",
      "translation": "Eu me alongo depois do treino.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8851_1778496589435.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008852",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Caliento antes del ejercicio.",
      "translation": "Eu me aqueço antes do exercício.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8852_1778496589612.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008853",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Sigo un plan de entrenamiento.",
      "translation": "Eu sigo um plano de treino.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8853_1778496585458.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008854",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Registro mi progreso.",
      "translation": "Eu acompanho meu progresso.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8854_1778496585619.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008855",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Intento mantenerme activo.",
      "translation": "Eu tento me manter ativo.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8855_1778496585796.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008856",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Camino todos los días.",
      "translation": "Eu caminho todos os dias.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8856_1778496589753.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008857",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Me concentro en mi dieta.",
      "translation": "Eu foco na minha dieta.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8857_1778496589910.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008858",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Como comida saludable.",
      "translation": "Eu como comida saudável.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8858_1778496585958.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008859",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Evito la comida basura.",
      "translation": "Eu evito porcarias.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8859_1778496590141.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008860",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Bebo mucha agua.",
      "translation": "Eu bebo muita água.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8860_1778496586114.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008861",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Duermo al menos siete horas.",
      "translation": "Eu durmo pelo menos sete horas.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8861_1778496586297.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008862",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Intento reducir el estrés.",
      "translation": "Eu tento reduzir o estresse.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8862_1778496586487.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008863",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Me tomo en serio los días de descanso.",
      "translation": "Eu levo os dias de descanso a sério.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8863_1778496590321.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008864",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Quiero volverme más fuerte.",
      "translation": "Eu quero ficar mais forte.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8864_1778496655241.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008865",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Quiero perder peso.",
      "translation": "Eu quero perder peso.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8865_1778496655457.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008866",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Quiero ganar músculo.",
      "translation": "Eu quero ganhar massa muscular.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8866_1778496586656.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008867",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Quiero mejorar mi resistencia.",
      "translation": "Eu quero melhorar minha resistência.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8867_1778496586815.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008868",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Me siento mejor cuando entreno.",
      "translation": "Eu me sinto melhor quando treino.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8868_1778496655696.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008869",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Vas al gimnasio a menudo.",
      "translation": "Você vai à academia com frequência.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8869_1778496586992.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008870",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Entrenas muy duro.",
      "translation": "Você treina muito pesado.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8870_1778496655889.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008871",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Sigues una rutina estricta.",
      "translation": "Você segue uma rotina rigorosa.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8871_1778496587204.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008872",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Registras tus calorías.",
      "translation": "Você monitora suas calorias.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8872_1778496587390.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008873",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Te enfocas en el entrenamiento de fuerza.",
      "translation": "Você foca no treinamento de força.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8873_1778496587551.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008874",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Prefieres los entrenamientos de cardio.",
      "translation": "Você prefere exercícios de cardio.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8874_1778496587740.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008875",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Estiras después del ejercicio.",
      "translation": "Você se alonga depois do exercício.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8875_1778496587962.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008876",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Comes sano la mayoría de los días.",
      "translation": "Você come de forma limpa na maioria dos dias.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8876_1778496656127.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008877",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Bebes suficiente agua.",
      "translation": "Você bebe água suficiente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8877_1778496656340.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008878",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Duermes bien por la noche.",
      "translation": "Você dorme bem à noite.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8878_1778496656550.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008879",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Evitas hábitos poco saludables.",
      "translation": "Você evita hábitos pouco saudáveis.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8879_1778496656718.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008880",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Te mantienes constante.",
      "translation": "Você se mantém consistente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8880_1778496656903.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008881",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Te recuperas adecuadamente.",
      "translation": "Você se recupera adequadamente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8881_1778496588127.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008882",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Escuchas a tu cuerpo.",
      "translation": "Você escuta o seu corpo.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8882_1778496657071.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008883",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él entrena cada mañana.",
      "translation": "Ele treina todas as manhãs.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8883_1778496588302.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008884",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él corre cinco kilómetros.",
      "translation": "Ele corre cinco quilômetros.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8884_1778496588477.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008885",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él levanta pesas pesadas.",
      "translation": "Ele levanta pesos pesados.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8885_1778496657302.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008886",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él sigue un plan de dieta.",
      "translation": "Ele segue um plano de dieta.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8886_1778496657510.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008887",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él registra sus entrenamientos.",
      "translation": "Ele monitora seus treinos.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8887_1778496657701.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008888",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él se enfoca en la fuerza.",
      "translation": "Ele foca na força.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8888_1778496658007.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008889",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él quiere ganar músculo.",
      "translation": "Ele quer ganhar massa muscular.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8889_1778496658263.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008890",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él quiere mejorar su resistencia.",
      "translation": "Ele quer melhorar seu vigor.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8890_1778496658452.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008891",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él estira a diario.",
      "translation": "Ele se alonga diariamente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8891_1778496658624.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008892",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él descansa cuando es necesario.",
      "translation": "Ele descansa quando necessário.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8892_1778496658807.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008893",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él evita la comida procesada.",
      "translation": "Ele evita alimentos processados.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8893_1778496658971.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008894",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él bebe batidos de proteínas.",
      "translation": "Ele bebe shakes de proteína.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8894_1778496659206.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008895",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él duerme ocho horas.",
      "translation": "Ele dorme oito horas.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8895_1778496659405.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008896",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Él se siente más fuerte ahora.",
      "translation": "Ele se sente mais forte agora.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8896_1778496659631.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008897",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella va a clases de yoga.",
      "translation": "Ela vai a aulas de ioga.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8897_1778496659824.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008898",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella entrena en casa.",
      "translation": "Ela malha em casa.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8898_1778496660021.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008899",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella sigue una dieta equilibrada.",
      "translation": "Ela segue uma dieta equilibrada.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8899_1778496660229.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008900",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella come muchas verduras.",
      "translation": "Ela come muitos vegetais.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8900_1778496660483.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008901",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella bebe suficiente agua.",
      "translation": "Ela bebe água suficiente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8901_1778496660671.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008902",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella duerme bien.",
      "translation": "Ela dorme bem.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8902_1778496660884.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008903",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella evita el azúcar.",
      "translation": "Ela evita o açúcar.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8903_1778496661096.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008904",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella quiere mantenerse en forma.",
      "translation": "Ela quer ficar em forma.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8904_1778496661315.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008905",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella quiere perder grasa.",
      "translation": "Ela quer perder gordura.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8905_1778496728725.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008906",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella entrena con un entrenador.",
      "translation": "Ela treina com um treinador.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8906_1778496729022.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008907",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella corre en el parque.",
      "translation": "Ela corre no parque.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8907_1778496729222.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008908",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella estira todos los días.",
      "translation": "Ela se alonga todos os dias.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8908_1778496729392.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008909",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Ella se siente más sana ahora.",
      "translation": "Ela se sente mais saudável agora.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8909_1778496729603.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008910",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Entrenamos juntos.",
      "translation": "Nós treinamos juntos.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8910_1778496729766.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008911",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Vamos al gimnasio con regularidad.",
      "translation": "Nós vamos à academia regularmente.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8911_1778496730005.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008912",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Seguimos la misma rutina.",
      "translation": "Nós seguimos a mesma rotina.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8912_1778496730182.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008913",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Nos apoyamos mutuamente.",
      "translation": "Nós nos apoiamos.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8913_1778496730336.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008914",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Registramos nuestro progreso.",
      "translation": "Nós acompanhamos nosso progresso.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8914_1778496730504.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008915",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Comemos comidas saludables.",
      "translation": "Nós comemos refeições saudáveis.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8915_1778496730669.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008916",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Cocinamos en casa.",
      "translation": "Nós cozinhamos em casa.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8916_1778496730839.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008917",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Evitamos la comida rápida.",
      "translation": "Nós evitamos fast food.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8917_1778496731002.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008918",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Bebemos mucha agua.",
      "translation": "Nós bebemos bastante água.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8918_1778496731148.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008919",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Dormimos suficientes horas.",
      "translation": "Nós dormimos horas suficientes.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8919_1778496731317.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008920",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000235",
      "text": "Estiramos después de entrenar.",
      "translation": "Nós nos alongamos depois do treino.",
      "explanation": "Frase da coleção: Health & Fitness",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/235_8920_1778496731472.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
