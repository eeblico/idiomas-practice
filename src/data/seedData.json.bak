      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Mi compañero de piso cocina a veces.",
      "translation": "Meu colega de quarto cozinha às vezes.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8662_1778496732434.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008663",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Mis padres cocinan todos los días.",
      "translation": "Meus pais cozinham todos os dias.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8663_1778496732783.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008664",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Mi madre cocina platos tradicionales.",
      "translation": "Minha mãe cozinha refeições tradicionais.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
