      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Cocinas muy bien.",
      "translation": "Você cozinha muito bem.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8595_1778496552541.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
