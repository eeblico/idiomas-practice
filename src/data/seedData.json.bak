      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7826_1775653323822.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007827",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We support each other always.",
      "translation": "Nós sempre nos apoiamos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7827_1775653324004.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007828",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We meet on special occasions.",
      "translation": "Nós nos encontramos em ocasiões especiais.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7828_1775653324197.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007829",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We celebrate birthdays together.",
      "translation": "Nós comemoramos aniversários juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7829_1775653324368.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007830",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We visit our parents regularly.",
      "translation": "Nós visitamos nossos pais regularmente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7830_1775653324587.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007831",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We talk in the family chat.",
      "translation": "Nós conversamos no chat da família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7831_1775653324759.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007832",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We help each other with problems.",
      "translation": "Nós nos ajudamos com problemas.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7832_1775653327186.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007833",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We travel together sometimes.",
      "translation": "Nós viajamos juntos às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7833_1775653329615.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007834",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We stay connected despite distance.",
      "translation": "Nós mantemos contato apesar da distância.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7834_1775653329803.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007835",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We argue a lot but forgive quickly.",
      "translation": "Nós discutimos muito, mas perdoamos rápido.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7835_1775653329998.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007836",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We care about each other deeply.",
      "translation": "Nós nos importamos profundamente uns com os outros.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7836_1775653423062.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007837",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They live close to their parents.",
      "translation": "Eles moram perto dos pais deles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7837_1775653445075.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007838",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They moved abroad years ago.",
      "translation": "Eles se mudaram para o exterior anos atrás.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7838_1775653544172.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007839",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They rarely see their relatives.",
      "translation": "Eles raramente veem seus parentes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7839_1775653548050.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007840",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They stay in touch online.",
      "translation": "Eles mantêm contato on-line.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7840_1775653553823.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007841",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They meet during holidays.",
      "translation": "Eles se encontram durante as férias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7841_1775653613057.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007842",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They support their children.",
      "translation": "Eles apoiam os filhos deles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7842_1775653617317.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007843",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They help their parents often.",
      "translation": "Eles ajudam os pais com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7843_1775653621275.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007844",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They spend weekends together.",
      "translation": "Eles passam os fins de semana juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7844_1775653624990.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007845",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They enjoy family dinners.",
      "translation": "Eles gostam de jantares em família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7845_1775653628595.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007846",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They share family traditions.",
      "translation": "Eles compartilham tradições familiares.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7846_1775653715580.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007847",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They raise their children together.",
      "translation": "Eles criam os filhos juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7847_1775653715772.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007848",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "They try to stay united.",
      "translation": "Eles tentam se manter unidos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7848_1775653718171.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007849",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My parents live nearby.",
      "translation": "Meus pais moram por perto.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7849_1775653718465.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007850",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My parents are very supportive.",
      "translation": "Meus pais dão muito apoio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7850_1775653718631.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007851",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My parents worked very hard.",
      "translation": "Meus pais trabalharam muito duro.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7851_1775653718818.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007852",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My father travels for work.",
      "translation": "Meu pai viaja a trabalho.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7852_1775653719039.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007853",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My mother calls me often.",
      "translation": "Minha mãe me liga com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7853_1775653719213.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007854",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My brother studies abroad.",
      "translation": "Meu irmão estuda no exterior.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7854_1775653719358.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007855",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My sister lives in another city.",
      "translation": "Minha irmã mora em outra cidade.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7855_1775653719560.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007856",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My grandparents live in the countryside.",
      "translation": "Meus avós moram no interior.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7856_1775653786518.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007857",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My relatives visit us often.",
      "translation": "Meus parentes nos visitam com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7857_1775653786721.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007858",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My family meets every year.",
      "translation": "Minha família se reúne todo ano.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7858_1775653786926.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007859",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your parents are very kind.",
      "translation": "Seus pais são muito gentis.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7859_1775653787108.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007860",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your father works a lot.",
      "translation": "Seu pai trabalha muito.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7860_1775653787403.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007861",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your mother is very patient.",
      "translation": "Sua mãe é muito paciente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7861_1775653787546.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007862",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your brother is very protective.",
      "translation": "Seu irmão é muito protetor.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7862_1775653787723.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007863",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your sister is very independent.",
      "translation": "Sua irmã é muito independente.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7863_1775653787897.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007864",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your family supports your goals.",
      "translation": "Sua família apoia seus objetivos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7864_1775653788083.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007865",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Your relatives live far away.",
      "translation": "Seus parentes moram longe.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7865_1775653788423.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007866",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "His parents are retired now.",
      "translation": "Os pais dele estão aposentados agora.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7866_1775653836820.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007867",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "His brother just got married.",
      "translation": "O irmão dele acabou de se casar.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7867_1775653836997.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007868",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "His sister is still studying.",
      "translation": "A irmã dele ainda está estudando.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7868_1775653837221.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007869",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "His family owns a small business.",
      "translation": "A família dele possui um pequeno negócio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7869_1775653839577.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007870",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "His relatives visit often.",
      "translation": "Os parentes dele visitam com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7870_1775653839831.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007871",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Her parents live abroad.",
      "translation": "Os pais dela moram no exterior.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7871_1775653840019.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007872",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Her brother works in finance.",
      "translation": "O irmão dela trabalha com finanças.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7872_1775653842264.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007873",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Her sister studies medicine.",
      "translation": "A irmã dela estuda medicina.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7873_1775653842489.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007874",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Her family is very close.",
      "translation": "A família dela é muito unida.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7874_1775653842677.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007875",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Her relatives meet every summer.",
      "translation": "Os parentes dela se reúnem todo verão.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7875_1775653842828.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007876",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Our parents are proud of us.",
      "translation": "Nossos pais têm orgulho de nós.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7876_1775653882030.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007877",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Our grandparents tell great stories.",
      "translation": "Nossos avós contam ótimas histórias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7877_1775653882271.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007878",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Our family values honesty.",
      "translation": "Nossa família valoriza a honestidade.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7878_1775653882610.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007879",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Our relatives live nearby.",
      "translation": "Nossos parentes moram por perto.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7879_1775653882788.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007880",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Our children play together.",
      "translation": "Nossos filhos brincam juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7880_1775653882962.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007881",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Their parents need support.",
      "translation": "Os pais deles precisam de apoio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7881_1775653883117.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007882",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Their children are still young.",
      "translation": "Os filhos deles ainda são jovens.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7882_1775653883412.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007883",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Their family travels together.",
      "translation": "A família deles viaja junta.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7883_1775653883654.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007884",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Their relatives live in another country.",
      "translation": "Os parentes deles moram em outro país.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7884_1775653883833.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007885",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Their home is always open to family.",
      "translation": "A casa deles está sempre aberta para a família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7885_1775653884033.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008709",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I go grocery shopping once a week.",
      "translation": "Eu faço compras de supermercado uma vez por semana.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8709_1775730385586.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008710",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I buy food for the whole week.",
      "translation": "Eu compro comida para a semana inteira.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8710_1775730385792.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008711",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I prefer shopping in the morning.",
      "translation": "Eu prefiro fazer compras de manhã.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8711_1775730385951.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008712",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I go to the supermarket nearby.",
      "translation": "Eu vou ao supermercado aqui perto.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8712_1775730386143.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008713",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I shop at a local market.",
      "translation": "Eu faço compras em um mercado local.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8713_1775730386327.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008714",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I buy fresh vegetables.",
      "translation": "Eu compro vegetais frescos.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8714_1775730386712.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008715",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I buy fresh fruit.",
      "translation": "Eu compro frutas frescas.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8715_1775730386904.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008716",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I choose seasonal products.",
      "translation": "Eu escolho produtos da estação.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8716_1775730387076.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008717",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I check prices carefully.",
      "translation": "Eu verifico os preços com cuidado.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8717_1775730389335.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008718",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I compare different brands.",
      "translation": "Eu comparo marcas diferentes.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8718_1775730389573.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008719",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I look for discounts.",
      "translation": "Eu procuro por descontos.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8719_1775730424129.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008720",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I try to save money.",
      "translation": "Eu tento economizar dinheiro.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8720_1775730424343.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008721",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I bring my own bags.",
      "translation": "Eu trago minhas próprias sacolas.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8721_1775730424527.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008722",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I avoid plastic bags.",
      "translation": "Eu evito sacolas plásticas.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8722_1775730424734.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008723",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I make a shopping list.",
      "translation": "Eu faço uma lista de compras.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8723_1775730424949.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008724",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I follow my list.",
      "translation": "Eu sigo a minha lista.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8724_1775730425140.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008725",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I forget things sometimes.",
      "translation": "Eu esqueço coisas às vezes.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8725_1775730425316.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008726",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I buy extra items.",
      "translation": "Eu compro itens extras.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8726_1775730425503.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008727",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I choose healthy food.",
      "translation": "Eu escolho comida saudável.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8727_1775730425758.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008728",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "I avoid junk food.",
      "translation": "Eu evito porcaria.",
      "explanation": "Frase da coleção: Grocery Shopping",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/234_8728_1775730425994.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008729",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "You go shopping every weekend.",
      "translation": "Você vai às compras todo fim de semana.",
