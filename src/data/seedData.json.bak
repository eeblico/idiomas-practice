      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009257",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Podría pedir que limpien mi habitación ahora?",
      "translation": "Você poderia mandar limpar meu quarto agora?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
