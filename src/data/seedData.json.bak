      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Creo que deberíamos revisarlo.",
      "translation": "Eu acho que deveríamos revisar isso.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
