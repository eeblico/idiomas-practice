      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009325",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿El hotel ofrece servicio de cambio de moneda?",
      "translation": "O hotel oferece serviço de câmbio?",
