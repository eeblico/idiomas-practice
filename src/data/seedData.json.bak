      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Esto puede esperar.",
      "translation": "Isto pode esperar.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9992_1778512099225.mp3",
