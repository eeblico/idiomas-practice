      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000234",
      "text": "Mi compañero de cuarto compra comestibles semanalmente.",
      "translation": "Meu colega de quarto compra mantimentos semanalmente.",
