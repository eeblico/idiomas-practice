      "id": "p1f13e77-9dfc-4b55-a0bc-000000013897",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000243",
      "text": "Leo diferentes géneros.",
      "translation": "Eu leio diferentes gêneros.",
      "explanation": "Frase da coleção: Intellectual & Learning",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/243_13897_1778499882414.mp3",
