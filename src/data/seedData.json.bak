      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9330_1778572201629.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009331",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Estoy esperando un paquete, ¿ha llegado ya?",
      "translation": "Estou esperando um pacote, ele já chegou?",
