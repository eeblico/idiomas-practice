      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000013893",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000243",
      "text": "Leo ficción por la noche.",
      "translation": "Eu leio ficção à noite.",
      "explanation": "Frase da coleção: Intellectual & Learning",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/243_13893_1778499881329.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000013894",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000243",
      "text": "Leo no ficción por la mañana.",
      "translation": "Eu leio não-ficção pela manhã.",
      "explanation": "Frase da coleção: Intellectual & Learning",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/243_13894_1778499881687.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
