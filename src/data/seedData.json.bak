      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Por favor, revise los detalles.",
      "translation": "Por favor, verifique os detalhes.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
