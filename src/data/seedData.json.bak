      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Su espacio de trabajo es moderno.",
      "translation": "O espaço de trabalho deles é moderno.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9891_1778512316835.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
