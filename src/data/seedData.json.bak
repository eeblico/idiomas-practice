      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Su oficina es grande.",
      "translation": "O escritório deles é grande.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9889_1778512316480.mp3",
