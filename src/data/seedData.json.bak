      "id": "p1f13e77-9dfc-4b55-a0bc-000000015530",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000266",
      "text": "I would like a hot chocolate.",
      "translation": "Eu gostaria de um chocolate quente.",
      "explanation": "Frase da coleção: In the café",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/266_15530_1776288700839.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
