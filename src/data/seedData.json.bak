      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "Llevo aprendiendo español aproximadamente un año.",
      "translation": "Estou aprendendo espanhol há cerca de um ano.",
