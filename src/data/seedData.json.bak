      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008652",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ellos compran ingredientes frescos.",
      "translation": "Eles compram ingredientes frescos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8652_1778496730300.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008653",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ellos comen juntos.",
      "translation": "Eles comem juntos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8653_1778496730484.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008654",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ellos cocinan para sus hijos.",
      "translation": "Eles cozinham para os seus filhos.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8654_1778496730646.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008655",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ellos prueban diferentes tipos de cocina.",
      "translation": "Eles experimentam culinárias diferentes.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8655_1778496730877.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008656",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ellos salen a comer de vez en cuando.",
      "translation": "Eles comem fora ocasionalmente.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8656_1778496731068.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
