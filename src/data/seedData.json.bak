      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9327_1778572043801.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009328",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Podría llamarme cuando la habitación esté lista, por favor?",
      "translation": "Você poderia me ligar quando o quarto estiver pronto, por favor?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
