      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7811_1775653187437.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007812",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He wants to start a family.",
      "translation": "Ele quer começar uma família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7812_1775653187754.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007813",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She lives far from her family.",
      "translation": "Ela mora longe da família dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7813_1775653188041.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007814",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She talks to her parents daily.",
      "translation": "Ela fala com os pais diariamente.",
