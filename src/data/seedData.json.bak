      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000266",
      "text": "I like the atmosphere here.",
      "translation": "Gosto do ambiente aqui.",
      "explanation": "Frase da coleção: In the café",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/266_15528_1776288700407.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000015529",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000266",
      "text": "Do you have a daily special?",
      "translation": "Você tem um prato do dia?",
      "explanation": "Frase da coleção: In the café",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/266_15529_1776288700649.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
