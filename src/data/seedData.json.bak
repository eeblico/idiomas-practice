      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10038_1778512606637.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
