    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009823",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él recibe a los visitantes.",
      "translation": "Ele recebe os visitantes.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9823_1778512185856.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009824",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él prepara documentos.",
      "translation": "Ele prepara documentos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9824_1778512253844.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009825",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él se une a reuniones diariamente.",
      "translation": "Ele participa de reuniões diariamente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9825_1778512254040.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009826",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él informa a su gerente.",
      "translation": "Ele se reporta ao seu gerente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9826_1778512254208.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009827",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él sigue las instrucciones.",
      "translation": "Ele segue instruções.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9827_1778512254386.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009828",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él completa las tareas rápidamente.",
      "translation": "Ele conclui tarefas rapidamente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9828_1778512254553.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009829",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él apoya al equipo.",
      "translation": "Ele apoia a equipe.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9829_1778512254748.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009830",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él se mantiene organizado.",
      "translation": "Ele se mantém organizado.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9830_1778512254910.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009831",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él se va a las seis.",
      "translation": "Ele sai às seis.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9831_1778512255099.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009832",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella trabaja en la oficina principal.",
      "translation": "Ela trabalha no escritório principal.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9832_1778512255249.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009833",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella prepara presentaciones.",
      "translation": "Ela prepara apresentações.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9833_1778512255401.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009834",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella escribe informes.",
      "translation": "Ela escreve relatórios.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9834_1778512255573.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009835",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella asiste a reuniones.",
      "translation": "Ela comparece a reuniões.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9835_1778512255738.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009836",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella habla con clientes.",
      "translation": "Ela fala com clientes.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9836_1778512255906.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009837",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella coordina con los equipos.",
      "translation": "Ela coordena com equipes.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9837_1778512256078.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009838",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella programa citas.",
      "translation": "Ela agenda compromissos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9838_1778512256313.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009839",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella actualiza archivos.",
      "translation": "Ela atualiza arquivos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9839_1778512256477.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009840",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella revisa los plazos.",
      "translation": "Ela verifica prazos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9840_1778512256722.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009841",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella se comunica con claridad.",
      "translation": "Ela se comunica claramente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9841_1778512256881.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009842",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella gestiona su tiempo.",
      "translation": "Ela gerencia o seu tempo.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9842_1778512257045.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009843",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ella se mantiene productiva.",
      "translation": "Ela se mantém produtiva.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9843_1778512257248.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009844",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Trabajamos en la misma oficina.",
      "translation": "Nós trabalhamos no mesmo escritório.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9844_1778512101043.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009845",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Compartimos un espacio de trabajo.",
      "translation": "Nós compartilhamos um espaço de trabalho.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9845_1778512182608.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009846",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Colaboramos en proyectos.",
      "translation": "Nós colaboramos em projetos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9846_1778512101212.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009847",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Asistimos a reuniones juntos.",
      "translation": "Nós participamos de reuniões juntos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9847_1778512182779.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009848",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Discutimos ideas.",
      "translation": "Nós discutimos ideias.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9848_1778512098173.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009849",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Resolvemos problemas.",
      "translation": "Nós resolvemos problemas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9849_1778512101495.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009850",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Compartimos actualizaciones.",
      "translation": "Nós compartilhamos atualizações.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9850_1778512182999.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009851",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Nos apoyamos mutuamente.",
      "translation": "Nós apoiamos uns aos outros.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9851_1778512101664.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009852",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Nos mantenemos organizados.",
      "translation": "Nós nos mantemos organizados.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9852_1778512257462.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009853",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Seguimos el horario.",
      "translation": "Nós seguimos o cronograma.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9853_1778512101862.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009854",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Cumplimos con los plazos.",
      "translation": "Nós cumprimos prazos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9854_1778512102044.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009855",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Terminamos las tareas juntos.",
      "translation": "Nós terminamos as tarefas juntos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9855_1778512102204.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009856",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos trabajan en el mismo piso.",
      "translation": "Eles trabalham no mesmo andar.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9856_1778512183160.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009857",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos asisten a reuniones regularmente.",
      "translation": "Eles participam de reuniões regularmente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9857_1778512183388.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009858",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos colaboran en las tareas.",
      "translation": "Eles colaboram em tarefas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9858_1778512102475.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009859",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos comparten información.",
      "translation": "Eles compartilham informações.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9859_1778512183565.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009860",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos apoyan al equipo.",
      "translation": "Eles apoiam a equipe.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9860_1778512102658.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009861",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos gestionan proyectos.",
      "translation": "Eles gerenciam projetos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9861_1778512097466.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009862",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos se comunican a diario.",
      "translation": "Eles se comunicam diariamente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9862_1778512257635.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009863",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos planifican su trabajo.",
      "translation": "Eles planejam seu trabalho.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9863_1778512257823.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009864",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos respetan los plazos.",
      "translation": "Eles respeitam prazos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9864_1778512257992.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009865",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos terminan a tiempo.",
      "translation": "Eles terminam no prazo.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9865_1778512183725.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009866",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos se mantienen profesionales.",
      "translation": "Eles se mantêm profissionais.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9866_1778512183889.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009867",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ellos se van juntos.",
      "translation": "Eles saem juntos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9867_1778512258192.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009868",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi escritorio está cerca de la ventana.",
      "translation": "Minha mesa é perto da janela.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9868_1778512258542.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009869",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi escritorio siempre está ordenado.",
      "translation": "Minha mesa está sempre arrumada.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9869_1778512258745.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009870",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi oficina es tranquila.",
      "translation": "Meu escritório é silencioso.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9870_1778512258953.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009871",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi oficina está muy ocupada hoy.",
      "translation": "Meu escritório está movimentado hoje.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9871_1778512259209.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009872",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi equipo trabaja bien unido.",
      "translation": "Minha equipe trabalha bem junta.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9872_1778512259455.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009873",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi gerente da instrucciones claras.",
      "translation": "Meu gerente dá instruções claras.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9873_1778512313434.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009874",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Mi colega me ayuda a menudo.",
      "translation": "Meu colega me ajuda frequentemente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9874_1778512313643.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009875",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Tu escritorio parece organizado.",
      "translation": "Sua mesa parece organizada.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9875_1778512313809.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009876",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Tu oficina es muy moderna.",
      "translation": "Seu escritório é muito moderno.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9876_1778512313973.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009877",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Tu equipo se comunica bien.",
      "translation": "Sua equipe se comunica bem.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9877_1778512314155.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
