      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000265",
      "text": "Me gustaría un zumo de naranja.",
      "translation": "Eu gostaria de um suco de laranja.",
      "explanation": "Frase da coleção: Bars & Restaurants",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/265_15357_1778573472098.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
