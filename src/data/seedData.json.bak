      "id": "p1f13e77-9dfc-4b55-a0bc-000000012454",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿Es difícil para ti?",
      "translation": "É difícil para você?",
