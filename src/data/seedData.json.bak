      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Esto cambia el alcance.",
      "translation": "Isso muda o escopo.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10025_1778512565803.mp3",
