      "id": "p1f13e77-9dfc-4b55-a0bc-000000015531",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000266",
      "text": "With whipped cream, please.",
      "translation": "Com chantilly, por favor.",
      "explanation": "Frase da coleção: In the café",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/266_15531_1776288701020.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
