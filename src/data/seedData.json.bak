      "id": "p1f13e77-9dfc-4b55-a0bc-000000009249",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Puede enviarme más agua embotellada?",
      "translation": "Você pode mandar mais água mineral?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
