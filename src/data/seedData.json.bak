      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Dónde puedo encontrar la oficina de correos más cercana?",
      "translation": "Onde posso encontrar o correio mais próximo?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9326_1778572043465.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
