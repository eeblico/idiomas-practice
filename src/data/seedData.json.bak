      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012983",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Quiero quedar para tomar un café.",
      "translation": "Eu quero me encontrar para um café.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12983_1778485860675.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012984",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Dónde quedamos?",
      "translation": "Onde vamos nos encontrar?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12984_1778485860837.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012985",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Podemos quedar en la cafetería.",
      "translation": "Podemos nos encontrar na cafeteria.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12985_1778485861030.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012986",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿A qué hora?",
      "translation": "Que horas?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12986_1778485861221.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012987",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Podemos quedar a las cuatro.",
      "translation": "Podemos nos encontrar às quatro.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12987_1778485861440.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012988",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Cuánto tardará?",
      "translation": "Quanto tempo vai levar?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12988_1778485861652.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012989",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Tardará diez minutos.",
      "translation": "Vai levar dez minutos.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12989_1778485861855.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012990",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Es tu primera vez aquí?",
      "translation": "É a sua primeira vez aqui?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12990_1778485862052.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012991",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Es mi primera vez aquí.",
      "translation": "Esta é a minha primeira vez aqui.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12991_1778485862219.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012992",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Vienes aquí a menudo?",
      "translation": "Você vem aqui com frequência?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12992_1778485862438.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012993",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "No vengo aquí a menudo.",
      "translation": "Eu não venho aqui com frequência.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12993_1778485881458.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012994",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Cómo conoces este sitio?",
      "translation": "Como você conhece este lugar?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12994_1778485881639.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012995",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Conozco este sitio por un amigo.",
      "translation": "Eu conheço este lugar através de um amigo.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12995_1778485881812.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012996",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Te gusta estar aquí?",
      "translation": "Você gosta daqui?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12996_1778485881987.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012997",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Me gusta estar aquí.",
      "translation": "Eu gosto daqui.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12997_1778485882149.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012998",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Te estás divirtiendo?",
      "translation": "Você está se divertindo?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12998_1778485882313.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012999",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Me estoy divirtiendo.",
      "translation": "Estou me divertindo.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_12999_1778485882492.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000013000",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "¿Quieres volver a hacer esto?",
      "translation": "Você quer fazer isso de novo?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_13000_1778485882703.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000013001",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000302",
      "text": "Quiero volver a hacer esto.",
      "translation": "Eu quero fazer isso de novo.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 3",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/302_13001_1778485882891.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008431",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Limpio la cocina todos los días.",
      "translation": "Eu limpo a cozinha todos os dias.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8431_1778496543040.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008432",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Lavo los platos después de la cena.",
      "translation": "Eu lavo a louça depois do jantar.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8432_1778496543244.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008433",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Saco la basura.",
      "translation": "Eu levo o lixo para fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8433_1778496543438.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008434",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Paso la aspiradora por el suelo.",
      "translation": "Eu aspiro o chão.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8434_1778496543635.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008435",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Friego el suelo una vez a la semana.",
      "translation": "Eu passo pano no chão uma vez por semana.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8435_1778496543799.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008436",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Hago la colada los fines de semana.",
      "translation": "Eu lavo a roupa nos fins de semana.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8436_1778496544006.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008437",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tiendo la ropa para que se seque.",
      "translation": "Eu estendo as roupas para secar.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8437_1778496550260.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008438",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Doblo la ropa más tarde.",
      "translation": "Eu dobro a roupa depois.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8438_1778496550473.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008439",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Plancho mis camisas.",
      "translation": "Eu passo minhas camisas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8439_1778496550682.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008440",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ordeno mi habitación.",
      "translation": "Eu arrumo meu quarto.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8440_1778496550873.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008441",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Hago mi cama cada mañana.",
      "translation": "Eu arrumo minha cama todas as manhãs.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8441_1778496551072.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008442",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Abro las ventanas para ventilar la habitación.",
      "translation": "Eu abro as janelas para arejar o quarto.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8442_1778496551393.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008443",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Cierro las ventanas por la noche.",
      "translation": "Eu fecho as janelas à noite.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8443_1778496551585.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008444",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Riego las plantas.",
      "translation": "Eu rego as plantas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8444_1778496551847.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008445",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Alimento a la mascota.",
      "translation": "Eu alimento o animal de estimação.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8445_1778496552049.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008446",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Cocino la cena la mayoría de los días.",
      "translation": "Eu cozinho o jantar na maioria dos dias.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8446_1778496552287.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008447",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Preparo el desayuno.",
      "translation": "Eu preparo o café da manhã.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8447_1778496552528.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008448",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Limpio el baño con regularidad.",
      "translation": "Eu limpo o banheiro regularmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8448_1778496552769.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008449",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Limpio la mesa después de las comidas.",
      "translation": "Eu limpo a mesa depois das refeições.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8449_1778496553004.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008450",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Organizo los estantes.",
      "translation": "Eu organizo as prateleiras.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8450_1778496553183.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008451",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Arreglo cosas pequeñas en casa.",
      "translation": "Eu conserto pequenas coisas em casa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8451_1778496553396.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008452",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Cambio la bombilla.",
      "translation": "Eu troco a lâmpada.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8452_1778496553632.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008453",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú limpias la sala de estar a menudo.",
      "translation": "Você limpa a sala com frequência.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8453_1778496553895.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008454",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú lavas los platos esta noche.",
      "translation": "Você lava a louça hoje à noite.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8454_1778496554144.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008455",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú sacas la basura por la noche.",
      "translation": "Você leva o lixo para fora à noite.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8455_1778496554399.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008456",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú pasas la aspiradora por la alfombra.",
      "translation": "Você aspira o tapete.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8456_1778496554631.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008457",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú friegas el suelo de la cocina.",
      "translation": "Você passa pano no chão da cozinha.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8457_1778496554859.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008458",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú haces la colada el domingo.",
      "translation": "Você lava a roupa no domingo.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8458_1778496555079.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008459",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú tiendes la ropa fuera.",
      "translation": "Você estende as roupas lá fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8459_1778496555299.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008460",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú doblas la ropa más tarde.",
      "translation": "Você dobra as roupas depois.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8460_1778496555485.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008461",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú planchas tu ropa con cuidado.",
      "translation": "Você passa suas roupas com cuidado.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8461_1778496628757.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008462",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú ordenas la casa antes de que lleguen los invitados.",
      "translation": "Você arruma a casa antes de os convidados chegarem.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8462_1778496629103.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008463",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú haces tu cama todos los días.",
      "translation": "Você arruma sua cama todos os dias.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8463_1778496629326.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008464",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú abres las ventanas por la mañana.",
      "translation": "Você abre as janelas de manhã.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8464_1778496629508.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008465",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú cierras la puerta por la noche.",
      "translation": "Você fecha a porta à noite.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8465_1778496629684.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008466",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú riegas las plantas con regularidad.",
      "translation": "Você rega as plantas regularmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8466_1778496629855.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008467",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú alimentas al perro.",
      "translation": "Você alimenta o cachorro.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8467_1778496630114.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008468",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú cocinas para todos.",
      "translation": "Você cozinha para todos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8468_1778496630357.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008469",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú limpias bien el baño.",
      "translation": "Você limpa bem o banheiro.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8469_1778496630540.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008470",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú limpias los mostradores.",
      "translation": "Você limpa os balcões.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8470_1778496630711.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008471",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú organizas los cajones.",
      "translation": "Você organiza as gavetas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8471_1778496630976.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008472",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tú arreglas cosas en casa.",
      "translation": "Você conserto coisas em casa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8472_1778496631179.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008473",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él limpia la cocina después de la cena.",
      "translation": "Ele limpa a cozinha depois do jantar.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8473_1778496631555.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008474",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él lava los platos todos los días.",
      "translation": "Ele lava a louça todos os dias.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8474_1778496631776.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008475",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él saca la basura.",
      "translation": "Ele leva o lixo para fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8475_1778496631985.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008476",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él pasa la aspiradora por el apartamento.",
      "translation": "Ele aspira o apartamento.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8476_1778496632181.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008477",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él friega el suelo con cuidado.",
      "translation": "Ele passa pano no chão com cuidado.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8477_1778496632338.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008478",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él hace la colada el sábado.",
      "translation": "Ele lava a roupa no sábado.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8478_1778496632525.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008479",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él tiende la ropa en el balcón.",
      "translation": "Ele estende as roupas na varanda.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8479_1778496632686.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008480",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él dobla la colada rápidamente.",
      "translation": "Ele dobra a roupa rapidamente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8480_1778496632865.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008481",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él plancha sus camisas.",
      "translation": "Ele passa as camisas dele.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8481_1778496633052.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008482",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él ordena la sala de estar.",
      "translation": "Ele arruma a sala.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8482_1778496633263.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008483",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él hace su cama cada mañana.",
      "translation": "Ele arruma a cama todas as manhãs.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8483_1778496633467.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008484",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él abre las ventanas.",
      "translation": "Ele abre as janelas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8484_1778496633810.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008485",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él lo cierra todo antes de irse.",
      "translation": "Ele fecha tudo antes de sair.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8485_1778496634151.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008486",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él riega las plantas.",
      "translation": "Ele rega as plantas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8486_1778496634320.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008487",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él alimenta al gato.",
      "translation": "Ele alimenta o gato.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8487_1778496634528.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008488",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él cocina la cena a veces.",
      "translation": "Ele cozinha o jantar às vezes.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8488_1778496634747.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008489",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él limpia el baño semanalmente.",
      "translation": "Ele limpa o banheiro semanalmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8489_1778496634969.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008490",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él limpia la mesa.",
      "translation": "Ele limpa a mesa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8490_1778496792030.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008491",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él organiza las herramientas.",
      "translation": "Ele organiza as ferramentas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8491_1778496792231.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008492",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Él arregla objetos rotos.",
      "translation": "Ele conserta itens quebrados.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8492_1778496792384.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008493",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella limpia la casa con regularidad.",
      "translation": "Ela limpa a casa regularmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8493_1778496798226.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008494",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella lava los platos después de las comidas.",
      "translation": "Ela lava a louça depois das refeições.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8494_1778496804770.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008495",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella saca la basura por la mañana.",
      "translation": "Ela leva o lixo para fora de manhã.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8495_1778496811031.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008496",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella pasa la aspiradora por los suelos.",
      "translation": "Ela aspira o chão.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8496_1778496818839.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008497",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella friega la cocina.",
      "translation": "Ela passa pano na cozinha.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8497_1778496819039.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008498",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella hace la colada a menudo.",
      "translation": "Ela lava a roupa com frequência.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8498_1778496819243.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008499",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella tiende la ropa para que se seque.",
      "translation": "Ela estende as roupas para secar.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8499_1778496819409.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008500",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella lo dobla todo con esmero.",
      "translation": "Ela dobra tudo com capricho.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8500_1778496819570.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008501",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella plancha la ropa con cuidado.",
      "translation": "Ela passa as roupas com cuidado.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8501_1778496819755.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008502",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella ordena las habitaciones.",
      "translation": "Ela arruma os quartos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8502_1778496819989.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008503",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella hace las camas.",
      "translation": "Ela arruma as camas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8503_1778496820158.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008504",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella abre las ventanas a diario.",
      "translation": "Ela abre as janelas diariamente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8504_1778496820323.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008505",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella riega las plantas.",
      "translation": "Ela rega as plantas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8505_1778496820489.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008506",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella alimenta a las mascotas.",
      "translation": "Ela alimenta os animais.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8506_1778496820646.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008507",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella cocina para la familia.",
      "translation": "Ela cozinha para a família.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8507_1778496820823.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008508",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella limpia el baño.",
      "translation": "Ela limpa o banheiro.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8508_1778496820987.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008509",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella limpia las superficies.",
      "translation": "Ela limpa as superfícies.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8509_1778496821175.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008510",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella organiza los armarios.",
      "translation": "Ela organiza os armários.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8510_1778496821345.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008511",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ella soluciona pequeños problemas.",
      "translation": "Ela conserta pequenos problemas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8511_1778496821495.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008512",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Limpiamos la casa juntos.",
      "translation": "Nós limpamos a casa juntos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8512_1778496821644.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008513",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Compartimos las tareas del hogar.",
      "translation": "Nós dividimos as tarefas domésticas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8513_1778496821865.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008514",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Lavamos los platos después de la cena.",
      "translation": "Nós lavamos a louça depois do jantar.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8514_1778496822114.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008515",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Nos turnamos con la basura.",
      "translation": "Nós nos revezamos com o lixo.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8515_1778496822275.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008516",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Pasamos la aspiradora cada fin de semana.",
      "translation": "Nós aspiramos todo fim de semana.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8516_1778496822448.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008517",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Fregamos los suelos juntos.",
      "translation": "Nós passamos pano no chão juntos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8517_1778496822611.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008518",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Hacemos la colada con regularidad.",
      "translation": "Nós lavamos a roupa regularmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8518_1778496822766.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008519",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tendemos la ropa fuera.",
      "translation": "Nós estendemos as roupas lá fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8519_1778496822939.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008520",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Lo doblamos todo más tarde.",
      "translation": "Nós dobramos tudo depois.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8520_1778496909903.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008521",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Planchamos la ropa cuando es necesario.",
      "translation": "Nós passamos as roupas quando necessário.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8521_1778496910138.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008522",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ordenamos la casa antes de que vengan invitados.",
      "translation": "Nós arrumamos a casa antes dos convidados virem.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8522_1778496910382.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008523",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Hacemos las camas cada mañana.",
      "translation": "Nós arrumamos as camas todas as manhãs.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8523_1778496910562.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008524",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Abrimos las ventanas a diario.",
      "translation": "Nós abrimos as janelas diariamente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8524_1778496910737.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008525",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Regamos las plantas.",
      "translation": "Nós regamos as plantas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8525_1778496910913.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008526",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Alimentamos a las mascotas juntos.",
      "translation": "Nós alimentamos os animais juntos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8526_1778496911140.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008527",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Cocinamos la cena juntos.",
      "translation": "Nós cozinhamos o jantar juntos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8527_1778496911326.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008528",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Limpiamos el baño semanalmente.",
      "translation": "Nós limpamos o banheiro semanalmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8528_1778496911510.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008529",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Limpiamos las mesas después de las comidas.",
      "translation": "Nós limpamos as mesas depois das refeições.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8529_1778496911719.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008530",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Organizamos el espacio de almacenamiento.",
      "translation": "Nós organizamos o depósito.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8530_1778496911982.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008531",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Arreglamos cosas por la casa.",
      "translation": "Nós consertamos coisas pela casa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8531_1778496912209.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008532",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos limpian la casa cada semana.",
      "translation": "Eles limpam a casa toda semana.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8532_1778496912446.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008533",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos comparten las tareas.",
      "translation": "Eles dividem as tarefas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8533_1778496912646.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008534",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos lavan los platos juntos.",
      "translation": "Eles lavam a louça juntos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8534_1778496912850.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008535",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos sacan la basura.",
      "translation": "Eles levam o lixo para fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8535_1778496913271.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008536",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos pasan la aspiradora por todo el apartamento.",
      "translation": "Eles aspiram o apartamento inteiro.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8536_1778496913448.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008537",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos friegan los suelos.",
      "translation": "Eles passam pano no chão.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8537_1778496913627.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008538",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos hacen la colada los domingos.",
      "translation": "Eles lavam a roupa aos domingos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8538_1778496913802.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008539",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos tienden la ropa fuera.",
      "translation": "Eles estendem as roupas lá fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8539_1778496913995.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008540",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos doblan la colada más tarde.",
      "translation": "Eles dobram a roupa depois.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8540_1778496914190.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008541",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos planchan su ropa.",
      "translation": "Eles passam as roupas deles.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8541_1778496914404.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008542",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos ordenan las habitaciones con regularidad.",
      "translation": "Eles arrumam os quartos regularmente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8542_1778496914649.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008543",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos hacen sus camas a diario.",
      "translation": "Eles arrumam as camas diariamente.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8543_1778496914912.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008544",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos abren las ventanas.",
      "translation": "Eles abrem as janelas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8544_1778496915092.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008545",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos riegan las plantas.",
      "translation": "Eles regam as plantas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8545_1778496915279.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008546",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos alimentan a las mascotas.",
      "translation": "Eles alimentam os animais.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8546_1778496915473.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008547",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos cocinan juntos.",
      "translation": "Eles cozinham as refeições juntos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8547_1778496915725.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008548",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos limpian el baño a menudo.",
      "translation": "Eles limpam o banheiro com frequência.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8548_1778496633981.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008549",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos limpian los mostradores de la cocina.",
      "translation": "Eles limpam os balcões da cozinha.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8549_1778496915922.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008550",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos organizan bien la casa.",
      "translation": "Eles organizam bem a casa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8550_1778496916151.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008551",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Ellos reparan cosas cuando es necesario.",
      "translation": "Eles consertam coisas quando necessário.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8551_1778496973015.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008552",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mi pareja limpia la cocina.",
      "translation": "Meu parceiro limpa a cozinha.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8552_1778496973273.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008553",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mi pareja cocina la mayoría de los días.",
      "translation": "Meu parceiro cozinha na maioria dos dias.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8553_1778496973506.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008554",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mi compañero de cuarto hace la colada.",
      "translation": "Meu colega de quarto lava a roupa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8554_1778496973713.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008555",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mis padres comparten las tareas.",
      "translation": "Meus pais dividem as tarefas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8555_1778496973953.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008556",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mis hijos ordenan sus habitaciones.",
      "translation": "Meus filhos arrumam seus quartos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8556_1778496974168.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008557",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mi hermano saca la basura.",
      "translation": "Meu irmão leva o lixo para fora.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8557_1778496974386.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008558",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Mi hermana riega las plantas.",
      "translation": "Minha irmã rega as plantas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8558_1778496974607.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008559",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tu pareja lava los platos.",
      "translation": "Seu parceiro lava a louça.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8559_1778496974807.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008560",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tu compañero de cuarto pasa la aspiradora.",
      "translation": "Seu colega de quarto aspira o chão.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8560_1778496975039.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008561",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tus padres limpian cada fin de semana.",
      "translation": "Seus pais limpam todo fim de semana.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8561_1778496975237.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008562",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Tus hijos ayudan en casa.",
      "translation": "Seus filhos ajudam em casa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8562_1778496975427.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008563",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Su compañero de cuarto cocina la cena.",
      "translation": "O colega de quarto dele cozinha o jantar.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8563_1778496975621.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008564",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Sus padres lo organizan todo.",
      "translation": "Os pais dele organizam tudo.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8564_1778496975857.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008565",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Sus hijos ayudan con las tareas.",
      "translation": "Os filhos dele ajudam com as tarefas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8565_1778496976042.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008566",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Su pareja limpia el baño.",
      "translation": "O parceiro dela limpa o banheiro.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8566_1778496976224.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008567",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Sus padres cocinan todos los días.",
      "translation": "Os pais dela cozinham todos os dias.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8567_1778496976433.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008568",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Sus hijos ordenan sus habitaciones.",
      "translation": "Os filhos dela arrumam seus quartos.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8568_1778496976686.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008569",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Nuestra familia comparte responsabilidades.",
      "translation": "Nossa família compartilha as responsabilidades.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8569_1778496977019.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008570",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Nuestro hogar funciona sin problemas.",
      "translation": "Nossa casa funciona bem.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8570_1778496977273.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008571",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Nuestras tareas se dividen equitativamente.",
      "translation": "Nossas tarefas são divididas de forma justa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8571_1778496977510.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008572",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Su casa siempre está limpia.",
      "translation": "A casa deles está sempre limpa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8572_1778496977766.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008573",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Sus tareas están bien organizadas.",
      "translation": "As tarefas deles são bem organizadas.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8573_1778496977970.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008574",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000232",
      "text": "Su familia trabaja junta en casa.",
      "translation": "A família deles trabalha junta em casa.",
      "explanation": "Frase da coleção: At Home",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/232_8574_1778496978194.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009791",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Llego a la oficina temprano.",
      "translation": "Eu chego cedo ao escritório.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9791_1778512184042.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009792",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Empiezo a trabajar a las nueve.",
      "translation": "Eu começo a trabalhar às nove.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9792_1778512184209.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009793",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Enciendo mi ordenador.",
      "translation": "Eu ligo o meu computador.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9793_1778512102880.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009794",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Primero reviso mis correos electrónicos.",
      "translation": "Eu verifico meus e-mails primeiro.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9794_1778512103128.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009795",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Reviso mi agenda.",
      "translation": "Eu reviso minha agenda.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9795_1778512184408.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009796",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Me preparo para las reuniones.",
      "translation": "Eu me preparo para reuniões.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9796_1778512184571.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009797",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Organizo mi escritorio.",
      "translation": "Eu organizo minha mesa.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9797_1778512184772.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009798",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Planifico mis tareas.",
      "translation": "Eu planejo minhas tarefas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9798_1778512103294.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009799",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Me concentro en las prioridades.",
      "translation": "Eu foco nas prioridades.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9799_1778512184927.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009800",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Trabajo en silencio.",
      "translation": "Eu trabalho silenciosamente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9800_1778512180528.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009801",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Tomo descansos cortos.",
      "translation": "Eu faço pausas curtas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9801_1778512180730.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009802",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Bebo café en mi escritorio.",
      "translation": "Eu bebo café na minha mesa.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9802_1778512099534.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009803",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Imprimo documentos.",
      "translation": "Eu imprimo documentos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9803_1778512180920.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009804",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Escaneo archivos.",
      "translation": "Eu digitalizo arquivos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9804_1778512181122.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009805",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Envío mensajes a mis colegas.",
      "translation": "Eu envio mensagens para colegas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9805_1778512181299.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009806",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Actualizo mi lista de tareas.",
      "translation": "Eu atualizo minhas tarefas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9806_1778512181471.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009807",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Termino mi trabajo a tiempo.",
      "translation": "Eu termino meu trabalho no prazo.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9807_1778512099718.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009808",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Tú llegas antes que todos los demás.",
      "translation": "Você chega antes de todo mundo.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9808_1778512099895.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009809",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Revisas los correos inmediatamente.",
      "translation": "Você verifica os e-mails imediatamente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9809_1778512100065.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009810",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Organizas tu espacio de trabajo.",
      "translation": "Você organiza seu espaço de trabalho.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9810_1778512181637.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009811",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Preparas la sala de reuniones.",
      "translation": "Você prepara a sala de reunião.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9811_1778512100263.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009812",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Te unes a reuniones en línea.",
      "translation": "Você participa de reuniões online.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9812_1778512181813.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009813",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Respondes a los mensajes rápidamente.",
      "translation": "Você responde às mensagens rapidamente.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9813_1778512182047.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009814",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Gestionas bien tus tareas.",
      "translation": "Você gerencia bem suas tarefas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9814_1778512182243.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009815",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Ayudas a tus colegas.",
      "translation": "Você ajuda seus colegas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9815_1778512182435.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009816",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Resuelves problemas pequeños.",
      "translation": "Você resolve pequenos problemas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9816_1778512100435.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009817",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Te mantienes concentrado.",
      "translation": "Você mantém o foco.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9817_1778512185085.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009818",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Cumples con los plazos.",
      "translation": "Você cumpre os prazos.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9818_1778512100604.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009819",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Te vas de la oficina tarde.",
      "translation": "Você sai do escritório tarde.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9819_1778512100788.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009820",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él trabaja en la recepción.",
      "translation": "Ele trabalha na recepção.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9820_1778512185306.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009821",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él se sienta cerca de la ventana.",
      "translation": "Ele senta perto da janela.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9821_1778512185497.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009822",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Él responde llamadas telefónicas.",
      "translation": "Ele atende chamadas telefônicas.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9822_1778512185684.mp3",
