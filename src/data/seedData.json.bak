      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010448",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "The total is on the screen.",
      "translation": "O total está na tela.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10448_1775809204929.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010449",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "You can pay by card.",
      "translation": "Você pode pagar com cartão.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10449_1775809205297.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010450",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "You can pay in cash.",
      "translation": "Você pode pagar em dinheiro.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10450_1775809205538.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010451",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Here is your change.",
      "translation": "Aqui está seu troco.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10451_1775809205868.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010452",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Have a safe trip.",
      "translation": "Tenha uma boa viagem.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10452_1775809206230.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010453",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Enjoy your meal.",
      "translation": "Bom apetite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10453_1775809243076.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010454",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Enjoy your stay.",
      "translation": "Aproveite sua estadia.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10454_1775809243267.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010455",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We hope to see you again.",
      "translation": "Esperamos vê-lo novamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10455_1775809243460.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010456",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Welcome to our hotel, we are delighted to have you with us this evening.",
      "translation": "Bem-vindo ao nosso hotel, estamos encantados em tê-lo conosco esta noite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10456_1775809243680.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010457",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Welcome to our restaurant, we are honored to host you tonight.",
      "translation": "Bem-vindo ao nosso restaurante, estamos honrados em recebê-lo esta noite.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10457_1775809243888.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010458",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Your suite is fully prepared and ready for your arrival.",
      "translation": "Sua suíte está totalmente preparada e pronta para sua chegada.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10458_1775809244208.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010459",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Your table on the terrace is ready, with a beautiful view of the city.",
      "translation": "Sua mesa no terraço está pronta, com uma bela vista da cidade.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10459_1775809244411.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010460",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Allow me to assist you with your luggage and escort you to your suite.",
      "translation": "Permita-me ajudá-lo com sua bagagem e acompanhá-lo até sua suíte.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10460_1775809244707.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010461",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Please follow me, I will personally show you to your table.",
      "translation": "Por favor, siga-me, eu pessoalmente o mostrarei sua mesa.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10461_1775809293710.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010462",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I confirm your reservation for two guests for three nights?",
      "translation": "Posso confirmar sua reserva para dois hóspedes por três noites?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10462_1775809295828.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010463",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I confirm your dinner reservation for four guests at eight o’clock?",
      "translation": "Posso confirmar sua reserva de jantar para quatro pessoas às oito horas?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10463_1775809297815.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010464",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "How may I assist you during your stay with us?",
      "translation": "Como posso ajudá-lo durante sua estadia conosco?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10464_1775809298076.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010465",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "How may we make your evening more enjoyable?",
      "translation": "Como podemos tornar sua noite mais agradável?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10465_1775809300087.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010466",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Here is your key card, which gives you access to the spa and private lounge.",
      "translation": "Aqui está seu cartão-chave, que lhe dá acesso ao spa e ao lounge privado.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10466_1775809300293.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010467",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Here is your menu, which features our seasonal tasting selection.",
      "translation": "Aqui está o seu cardápio, que apresenta a nossa seleção de degustação sazonal.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10467_1775809300473.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010468",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Here are the details of your reservation, including breakfast and spa access.",
      "translation": "Aqui estão os detalhes da sua reserva, incluindo café da manhã e acesso ao spa.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10468_1775809300651.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010469",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Allow me to check that for you and confirm the availability immediately.",
      "translation": "Permita-me verificar isso para você e confirmar a disponibilidade imediatamente.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10469_1775809385908.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010470",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "I will personally arrange a late checkout for tomorrow at two o’clock.",
      "translation": "Eu pessoalmente organizarei um check-out tardio para amanhã às duas horas.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10470_1775809386093.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010471",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "I will organize private transportation to the airport for you.",
      "translation": "Vou organizar o transporte privado para o aeroporto para você.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10471_1775809386281.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010472",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "I will contact our concierge to arrange a private city tour.",
      "translation": "Vou entrar em contato com nosso concierge para agendar um passeio privado pela cidade.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10472_1775809386546.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010473",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Would you prefer a table indoors in a quieter area, or outside on the terrace?",
      "translation": "Você prefere uma mesa interna em uma área mais tranquila ou lá fora no terraço?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10473_1775809386728.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010474",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Would you care for a glass of champagne while you review the menu?",
      "translation": "Gostaria de uma taça de champanhe enquanto analisa o cardápio?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10474_1775809386949.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010475",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I recommend our chef’s tasting menu, which includes five signature dishes?",
      "translation": "Posso recomendar o nosso menu degustação do chef, que inclui cinco pratos exclusivos?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10475_1775809387148.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010476",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I suggest a wine pairing to complement your selection?",
      "translation": "Posso sugerir uma harmonização de vinhos para complementar sua seleção?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10476_1775809387356.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010477",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Are you ready to order, or would you prefer a few more moments to decide?",
      "translation": "Você está pronto para pedir ou prefere mais alguns momentos para decidir?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10477_1775809430690.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010478",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I take your order now and answer any questions about the dishes?",
      "translation": "Posso anotar seu pedido agora e tirar qualquer dúvida sobre os pratos?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10478_1775809430880.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010479",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "How would you like your steak prepared, medium rare or medium?",
      "translation": "Como você gostaria do seu bife, malpassado ou ao ponto?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10479_1775809431036.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010480",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I bring you another glass of wine while you enjoy your main course?",
      "translation": "Posso lhe trazer outra taça de vinho enquanto aprecia seu prato principal?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10480_1775809432932.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010481",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I refresh your water or offer you sparkling water instead?",
      "translation": "Posso repor sua água ou oferecer água com gás no lugar?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10481_1775809433119.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010482",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "May I clear the table so you can enjoy your dessert comfortably?",
      "translation": "Posso limpar a mesa para que você possa desfrutar da sua sobremesa confortavelmente?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10482_1775809433303.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010483",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Is everything to your satisfaction with your meal this evening?",
      "translation": "Está tudo a seu contento com sua refeição esta noite?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10483_1775809433515.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010484",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Is the temperature in your suite comfortable for you?",
      "translation": "A temperatura em sua suíte está confortável para você?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10484_1775809435348.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010485",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Is there anything we can prepare to make your stay more pleasant?",
      "translation": "Há algo que possamos preparar para tornar sua estadia mais agradável?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10485_1775809513017.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010486",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Your dessert will be served shortly, as it is freshly prepared by our pastry chef.",
      "translation": "Sua sobremesa será servida em breve, pois é preparada na hora pelo nosso confeiteiro.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10486_1775809513218.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010487",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Your car will be waiting at the entrance in five minutes.",
      "translation": "Seu carro estará esperando na entrada em cinco minutos.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10487_1775809513398.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010488",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Your spa appointment is confirmed for ten o’clock tomorrow morning.",
      "translation": "Seu horário no spa está confirmado para amanhã às dez horas da manhã.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10488_1775809513572.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010489",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Breakfast is served in our main dining room from seven to ten each morning.",
      "translation": "O café da manhã é servido em nossa sala de jantar principal das sete às dez todas as manhãs.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10489_1775809513728.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010490",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "The spa is open until nine o’clock this evening for your convenience.",
      "translation": "O spa está aberto até às nove horas esta noite para sua conveniência.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10490_1775809513975.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010491",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Our concierge is available at any time to assist you with special requests.",
      "translation": "Nosso concierge está disponível a qualquer momento para ajudá-lo com pedidos especiais.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10491_1775809514231.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010492",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We would be pleased to arrange a private boat tour along the coast for tomorrow afternoon.",
      "translation": "Teremos o prazer de organizar um passeio de barco privado pela costa para amanhã à tarde.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10492_1775809514417.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010493",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We can reserve a table at one of the finest restaurants in the city on your behalf.",
      "translation": "Podemos reservar uma mesa em um dos melhores restaurantes da cidade em seu nome.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10493_1775809564107.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010494",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We can organize a personal shopping experience with a local stylist.",
      "translation": "Podemos organizar uma experiência de compras pessoal com um estilista local.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10494_1775809564304.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010495",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "I sincerely apologize for the delay, and we are preparing your suite with priority.",
      "translation": "Peço sinceras desculpas pelo atraso e estamos preparando sua suíte com prioridade.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10495_1775809564474.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010496",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Please allow us to correct this immediately and offer you a complimentary drink while you wait.",
      "translation": "Por favor, permita-nos corrigir isso imediatamente e oferecer-lhe uma bebida cortesia enquanto espera.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10496_1775809564686.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010497",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Thank you for bringing this matter to our attention, we truly value your feedback.",
      "translation": "Obrigado por nos chamar a atenção para este assunto, nós realmente valorizamos o seu feedback.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10497_1775809566993.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010498",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We will ensure that everything is handled discreetly and efficiently.",
      "translation": "Garantiremos que tudo seja tratado com discrição e eficiência.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10498_1775809567172.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010499",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We will follow up with you later this evening to confirm that everything meets your expectations.",
      "translation": "Entraremos em contato com você ainda hoje para confirmar que tudo atende às suas expectativas.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10499_1775809567355.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010500",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Your comfort and privacy are our highest priorities during your stay.",
      "translation": "Seu conforto e privacidade são nossas maiores prioridades durante sua estadia.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10500_1775809567541.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010501",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We are committed to providing you with an exceptional experience.",
      "translation": "Estamos comprometidos em proporcionar a você uma experiência excepcional.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10501_1775809611374.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010502",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Are you checking in for three nights starting today?",
      "translation": "Você está fazendo o check-in para três noites a partir de hoje?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10502_1775809611821.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010503",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Are you checking out this morning, and may we assist you with your luggage?",
      "translation": "Você está fazendo o check-out esta manhã e podemos ajudá-lo com sua bagagem?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10503_1775809612071.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010504",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Did you enjoy your stay with us during your visit?",
      "translation": "Você gostou de sua estadia conosco durante sua visita?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10504_1775809612230.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010505",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Would you like us to arrange your next stay in advance?",
      "translation": "Gostaria que organizássemos sua próxima estadia com antecedência?",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10505_1775809612385.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010506",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "The total amount for your stay is displayed here for your review, including all services requested.",
      "translation": "O valor total de sua estadia está exibido aqui para sua revisão, incluindo todos os serviços solicitados.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10506_1775809612619.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010507",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "You may complete the payment by card, and I will process it immediately for you.",
      "translation": "Você pode concluir o pagamento com cartão e eu o processarei imediatamente para você.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10507_1775809612785.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010508",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "Here is your receipt, and we thank you sincerely for staying with us.",
      "translation": "Aqui está o seu recibo e agradecemos sinceramente por se hospedar conosco.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10508_1775809674672.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010509",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We wish you a pleasant evening and hope you enjoy the rest of your stay.",
      "translation": "Desejamos-lhe uma noite agradável e esperamos que aproveite o resto da sua estadia.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10509_1775809680501.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010510",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000254",
      "text": "We look forward to welcoming you back for another exceptional experience.",
      "translation": "Estamos ansiosos para recebê-lo de volta para outra experiência excepcional.",
      "explanation": "Frase da coleção: Hospitality Industry",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/254_10510_1775809687382.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009219",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Hello, I have a reservation under the name John Smith.",
      "translation": "Olá, eu tenho uma reserva no nome de John Smith.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9219_1775751061906.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009220",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "I would like to check in, please.",
      "translation": "Eu gostaria de fazer o check-in, por favor.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9220_1775751062113.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009221",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Here is my passport and my credit card for the deposit.",
      "translation": "Aqui estão o meu passaporte e o meu cartão de crédito para o depósito.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9221_1775751062290.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009222",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Is the room ready yet?",
      "translation": "O quarto já está pronto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9222_1775751062481.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009223",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "What time is the check-out tomorrow?",
      "translation": "A que horas é o check-out amanhã?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9223_1775751062657.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009224",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Does the room have a view of the city?",
      "translation": "O quarto tem vista para a cidade?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9224_1775751062848.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009225",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Is there a safe in the room for my valuables?",
      "translation": "Tem um cofre no quarto para os meus pertences de valor?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9225_1775751063052.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009226",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Can I get two key cards for the room?",
      "translation": "Pode me dar dois cartões-chave para o quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9226_1775751063212.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009227",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Which floor is my room on?",
      "translation": "Em qual andar fica o meu quarto?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9227_1775751063423.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009228",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Where are the elevators located?",
      "translation": "Onde ficam localizados os elevadores?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/261_9228_1775751063588.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009229",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Is there someone who can help me with my bags?",
      "translation": "Há alguém que possa me ajudar com minhas malas?",
