    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008606",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Disfrutas de las comidas caseras.",
      "translation": "Você gosta de refeições caseiras.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8606_1778496552925.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
