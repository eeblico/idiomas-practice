      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Ellos piden comida a veces.",
      "translation": "Eles pedem comida às vezes.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8657_1778496731247.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
