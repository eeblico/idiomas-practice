      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7732_1775650732882.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007733",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We talk often.",
      "translation": "Nós conversamos com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7733_1775650733104.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007734",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We see each other every week.",
      "translation": "Nós nos vemos toda semana.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7734_1775650733389.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007735",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We see each other on holidays.",
      "translation": "Nós nos vemos nos feriados.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7735_1775650733664.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007736",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We do not see each other very often.",
      "translation": "Nós não nos vemos com muita frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7736_1775650799850.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007737",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We support each other.",
      "translation": "Nós nos apoiamos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7737_1775650800028.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007738",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We help each other a lot.",
      "translation": "Nós nos ajudamos muito.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7738_1775650800272.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007739",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We argue sometimes.",
      "translation": "Nós discutimos às vezes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7739_1775650800539.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007740",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Every family has problems.",
      "translation": "Toda família tem problemas.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7740_1775650800748.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007741",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "Family is very important to me.",
      "translation": "A família é muito importante para mim.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7741_1775650801020.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007742",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "I spend a lot of time with my family.",
      "translation": "Eu passo muito tempo com a minha família.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7742_1775650801315.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007743",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "I wish I could spend more time with them.",
      "translation": "Eu gostaria de poder passar mais tempo com eles.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7743_1775650801498.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007744",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We usually eat together.",
      "translation": "Nós costumamos comer juntos.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7744_1775650801714.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007745",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "We celebrate birthdays together.",
      "translation": "Nós comemoramos aniversários juntos.",
