      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000010030",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Por favor, revise el documento.",
      "translation": "Por favor, revise o documento.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10030_1778512566462.mp3",
