      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009881",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Su equipo trabaja eficientemente.",
      "translation": "A equipe dele trabalha com eficiência.",
