    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007714",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "I am the middle child.",
      "translation": "Eu sou o filho do meio.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7714_1775650657591.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
