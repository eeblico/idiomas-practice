      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012468",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿A qué hora terminas?",
      "translation": "A que horas você termina?",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 1",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12468_1778485554793.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012469",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "Termino de trabajar a las cinco.",
      "translation": "Eu termino o trabalho às cinco.",
      "explanation": "Frase da coleção: 300 Questions & Answers - Part 1",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12469_1778485555157.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012470",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿Almuerzas en casa o fuera?",
      "translation": "Você almoça em casa ou fora?",
