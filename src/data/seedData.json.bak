      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009329",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "El suelo de mi habitación está un poco polvoriento.",
      "translation": "O chão do meu quarto está um pouco empoeirado.",
