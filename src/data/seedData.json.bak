      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7814_1775653188277.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007815",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She helps her sister with problems.",
      "translation": "Ela ajuda a irmã com problemas.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7815_1775653188444.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007816",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She takes care of her children.",
      "translation": "Ela cuida dos filhos dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7816_1775653246330.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007817",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She spends time with relatives.",
      "translation": "Ela passa tempo com os parentes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7817_1775653246559.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007818",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She worries about her parents.",
      "translation": "Ela se preocupa com os pais dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7818_1775653246780.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007819",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She visits them during holidays.",
      "translation": "Ela os visita durante as férias.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7819_1775653246972.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007820",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She sends gifts to her family.",
      "translation": "Ela envia presentes para a família dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7820_1775653247275.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007821",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She respects her grandparents.",
      "translation": "Ela respeita os avós dela.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7821_1775653247492.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007822",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "She loves family gatherings.",
      "translation": "Ela ama reuniões de família.",
