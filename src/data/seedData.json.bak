      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/300_12459_1778485552756.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000012460",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000300",
      "text": "¿Qué sueles desayunar?",
      "translation": "O que você costuma comer no café da manhã?",
