      "id": "p1f13e77-9dfc-4b55-a0bc-000000007716",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "My parents are divorced.",
      "translation": "Meus pais são divorciados.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7716_1775650693227.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
