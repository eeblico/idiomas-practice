      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000265",
      "text": "Sin alcohol para mí, gracias.",
      "translation": "Nada de álcool para mim, obrigado.",
      "explanation": "Frase da coleção: Bars & Restaurants",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/265_15356_1778573471840.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
