      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009256",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "Por favor, no molesten en mi habitación hoy.",
      "translation": "Por favor, não perturbe meu quarto hoje.",
