      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Mi pareja cocina la cena.",
      "translation": "Meu parceiro cozinha o jantar.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8660_1778496731866.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008661",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Mi pareja prepara el desayuno.",
      "translation": "Meu parceiro prepara o café da manhã.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8661_1778496732067.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
