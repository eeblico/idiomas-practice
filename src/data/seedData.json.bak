      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Su oficina es tranquila.",
      "translation": "O escritório dela é silencioso.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_9883_1778512315313.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009884",
