      "id": "p1f13e77-9dfc-4b55-a0bc-000000009334",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Puedo obtener una lista de contactos de emergencia cercanos?",
      "translation": "Posso ter uma lista de contatos de emergência próximos?",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/261_9334_1778572203239.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
