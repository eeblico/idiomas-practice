      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000008668",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000233",
      "text": "Tu pareja cocina muy bien.",
      "translation": "Seu parceiro cozinha muito bem.",
      "explanation": "Frase da coleção: Cooking & Meals",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/233_8668_1778496818842.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
