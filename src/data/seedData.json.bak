    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000009246",
      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "La luz del baño parpadea.",
      "translation": "A luz do banheiro está piscando.",
      "explanation": "Frase da coleção: Hotels & Accommodation",
      "difficulty": "easy",
