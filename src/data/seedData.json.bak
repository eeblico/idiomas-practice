      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Esto mejora el resultado.",
      "translation": "Isso melhora o resultado.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10026_1778512098623.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
