      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7808_1775653186895.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007809",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He visits his grandparents often.",
      "translation": "Ele visita os avós com frequência.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7809_1775653187051.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007810",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He stays connected with relatives.",
      "translation": "Ele mantém contato com os parentes.",
      "explanation": "Frase da coleção: Family",
      "difficulty": "medium",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/en-US/272_7810_1775653187284.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
    {
      "id": "p1f13e77-9dfc-4b55-a0bc-000000007811",
      "language_id": "en",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000272",
      "text": "He moved back home last year.",
      "translation": "Ele voltou para casa no ano passado.",
