      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000265",
      "text": "Ya estamos listos para pedir.",
      "translation": "Estamos prontos para pedir agora.",
      "explanation": "Frase da coleção: Bars & Restaurants",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/265_15362_1778573473601.mp3",
      "voice_name": "Fenrir",
      "speed": 1
    },
