      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000251",
      "text": "Estamos con retraso.",
      "translation": "Estamos atrasados com o cronograma.",
      "explanation": "Frase da coleção: At the Office",
      "difficulty": "easy",
      "audio_url": "https://audio.hyperlingua.app/audio/ae/gc/es-ES/251_10039_1778512606850.mp3",
