      "language_id": "es",
      "category_id": "c8f13e77-9dfc-4b55-a0bc-000000000261",
      "text": "¿Puede ayudarme a reservar una entrada para el teatro?",
      "translation": "Pode me ajudar a reservar um ingresso para o teatro?",
